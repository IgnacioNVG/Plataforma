---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Fuentes de Google: IBM Plex Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    <title>{title} | Juventud Socialista</title>
    <!-- Astro View Transitions -->
    <ClientRouter />
  </head>
  <body class="bg-[var(--color-background)] text-[var(--color-foreground)] font-sans min-h-screen flex flex-col selection:bg-[var(--color-primary)] selection:text-white">
    
    <main class="flex-1 flex flex-col md:flex-row">
      <!-- Columna Gráfica / Editorial -->
      <div class="hidden md:flex flex-col md:w-1/2 lg:w-3/5 bg-[var(--color-foreground)] text-[var(--color-background)] p-12 justify-between relative overflow-hidden">
        <!-- Elementos decorativos brutalistas -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-[var(--color-primary)] opacity-20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-0 w-full h-1/2 bg-gradient-to-t from-[var(--color-primary)] to-transparent opacity-10"></div>
        
        <div class="relative z-10">
          <h1 class="text-3xl font-bold tracking-tight uppercase border-l-4 border-[var(--color-primary)] pl-4">Plataforma Institucional</h1>
          <p class="mt-2 text-[var(--color-muted-foreground)] uppercase tracking-widest text-sm font-bold">Juventud Socialista de Chile</p>
        </div>
        
        <div class="relative z-10 max-w-lg">
          <h2 class="text-5xl lg:text-7xl font-black uppercase tracking-tighter leading-[0.9] mb-8">
            La fuerza de<br/>
            <span class="text-[var(--color-primary)]">nuestra</span><br/>
            historia
          </h2>
          <p class="text-lg font-medium text-gray-300 border-l-4 border-[var(--color-primary)] pl-6">
            Acceso restringido. Este sistema es de uso exclusivo para la militancia regular. Todo acceso y acción queda registrado en los sistemas de auditoría central.
          </p>
        </div>
      </div>

      <!-- Columna del Formulario -->
      <div class="w-full md:w-1/2 lg:w-2/5 p-8 lg:p-16 flex flex-col justify-center bg-[var(--color-background)] relative overflow-y-auto">
        <slot />
      </div>
    </main>

  </body>
</html>
