---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { db } from '../db';
import { notificationTable } from '../db/schema';
import { and, eq, lte, or, isNull, sql } from 'drizzle-orm';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const user = Astro.locals.user;

let unreadCount = 0;
if (user) {
  const result = await db.select({
    count: sql<number>`count(*)`
  }).from(notificationTable)
    .where(
      and(
        eq(notificationTable.userId, user.id),
        eq(notificationTable.isRead, false),
        eq(notificationTable.isArchived, false),
        or(
          isNull(notificationTable.scheduledFor),
          lte(notificationTable.scheduledFor, new Date())
        )
      )
    );
  unreadCount = Number(result[0]?.count || 0);
}

const navItems = [
  { name: 'Inicio', href: '/', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>' },
  { name: 'Noticias', href: '/noticias', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15"></path></svg>' },
  { name: 'Escuela de Formación', href: '/escuela', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14v7"></path></svg>' },
  { name: 'Biblioteca', href: '/biblioteca', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>' },
  { name: 'Historia', href: '/historia', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>' },
  { name: 'Agenda', href: '/agenda', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>' },
  { name: 'Comisiones', href: '/comisiones', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>' },
  { name: 'Foros', href: '/foros', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path></svg>' },
  { name: 'Directorio', href: '/directorio', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>' },
  { name: 'Mi Perfil', href: '/perfil', icon: '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Fuentes de Google: IBM Plex Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    <title>{title} | Plataforma Militante Socialista</title>
    <!-- Astro View Transitions para animación entre páginas -->
    <ClientRouter />
  </head>
  <body>
    <div class="min-h-screen bg-[var(--color-background)] text-[var(--color-foreground)] font-sans flex">
      
      <!-- Sidebar -->
      <aside class="w-64 bg-[var(--color-secondary)] border-r border-[var(--color-border)] hidden md:flex flex-col h-screen sticky top-0">
        <div class="p-6 border-b border-[var(--color-border)] flex items-center gap-3">
          <div class="relative">
            <img src="/logo.svg" alt="Logo PMS" class="w-10 h-10 flex-shrink-0 object-contain drop-shadow-[2px_2px_0px_rgba(0,0,0,0.8)]" />
            <span class="absolute -top-2 -right-2 bg-red-600 text-white text-[9px] font-black px-1.5 py-0.5 transform rotate-[15deg] shadow-[2px_2px_0px_0px_rgba(0,0,0,0.5)] border-2 border-white z-10">BETA</span>
          </div>
          <div>
            <h1 class="text-sm font-black tracking-tight uppercase leading-[1.1]">Plataforma<br/>Militante<br/>Socialista</h1>
          </div>
        </div>
        
        <nav class="flex-1 overflow-y-auto py-4">
          <ul class="space-y-1 px-3">
            {navItems.map((item) => {
              const active = isActive(item.href);
              return (
                <li class="relative">
                  <a href={item.href} class={`flex items-center gap-3 px-3 py-2 rounded-[var(--radius-sm)] font-medium text-sm transition-colors relative z-10 ${active ? 'text-white' : 'text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] hover:bg-[var(--color-border)]'}`}>
                    <Fragment set:html={item.icon} />
                    {item.name}
                  </a>
                  {active && (
                    <div transition:name="nav-active-bg" class="absolute inset-0 bg-[var(--color-foreground)] rounded-[var(--radius-sm)] z-0 shadow-sm border border-[var(--color-foreground)]"></div>
                  )}
                </li>
              );
            })}
            
            {/* El panel de administración unificado fue eliminado a petición del usuario. Los botones de creación estarán en cada página pública respectiva. */}
          </ul>
        </nav>

        <!-- Perfil Inferior -->
        {Astro.locals.user && (
        <div class="p-4 border-t border-[var(--color-border)] mt-auto">
          <a href="/perfil" class="flex items-center gap-3 group hover:bg-gray-200 p-2 -mx-2 rounded-[var(--radius-sm)] transition-colors">
            <div class="w-10 h-10 bg-[var(--color-border)] rounded-none overflow-hidden flex-shrink-0 border-2 border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-primary)] group-hover:shadow-[0px_0px_0px_0px_var(--color-primary)] group-hover:translate-x-0.5 group-hover:translate-y-0.5 transition-all">
              {Astro.locals.user.avatarUrl ? (
                <img src={Astro.locals.user.avatarUrl} alt="Avatar" class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gray-400 flex items-center justify-center text-sm font-black text-white uppercase">
                  {(Astro.locals.user.name || 'U').charAt(0)}{(Astro.locals.user.lastName || 'S').charAt(0)}
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-black text-[var(--color-foreground)] uppercase tracking-tight truncate">{Astro.locals.user.name} {Astro.locals.user.lastName}</p>
              <p class="text-[10px] font-bold text-[var(--color-primary)] uppercase tracking-widest truncate">Ver Mi Perfil</p>
            </div>
          </a>
        </div>
        )}
      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 flex flex-col min-w-0 bg-[var(--color-background)]">
        
        <!-- Topbar -->
        <header class="h-16 border-b border-[var(--color-border)] bg-[var(--color-background)] flex items-center justify-between px-8 sticky top-0 z-10">
          <div class="flex-1 flex items-center">
            <!-- Search Bar (Command Palette trigger) -->
            <button class="flex items-center gap-2 text-sm text-[var(--color-muted-foreground)] bg-[var(--color-secondary)] border border-[var(--color-border)] px-3 py-1.5 rounded-[var(--radius-sm)] hover:border-[var(--color-foreground)] transition-colors w-64">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              Buscar... <span class="ml-auto text-xs opacity-50">⌘K</span>
            </button>
          </div>
          
          <div class="flex items-center gap-4">
            <a href="/notificaciones" class="p-2 text-[var(--color-foreground)] hover:bg-[var(--color-secondary)] rounded-[var(--radius-sm)] relative block transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
              {unreadCount > 0 && (
                <span class="absolute top-0 right-0 w-4 h-4 bg-[var(--color-primary)] text-white text-[10px] font-bold flex items-center justify-center rounded-full">
                  {unreadCount > 9 ? '9+' : unreadCount}
                </span>
              )}
            </a>
          </div>
        </header>

        <!-- Page Content Slot -->
        <div class="flex-1 p-8 overflow-y-auto relative" transition:animate="fade">
          <slot />
        </div>
        
      </main>
    </div>
  </body>
</html>
