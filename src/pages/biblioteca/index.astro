---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { documentTable, userTable } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
const documents = await db
  .select({
    doc: documentTable,
    author: userTable
  })
  .from(documentTable)
  .leftJoin(userTable, eq(documentTable.authorId, userTable.id))
  .orderBy(desc(documentTable.createdAt))
  .all();
---

<AppLayout title="Biblioteca y Documentos">
  <div class="mb-8 border-b border-[var(--color-foreground)] pb-6 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
      <h1 class="text-4xl font-bold text-[var(--color-foreground)]">Repositorio Central</h1>
      <p class="text-[var(--color-muted-foreground)] mt-2 max-w-2xl">Acervo documental, actas, declaraciones y material de estudio histórico.</p>
    </div>
    
    <div class="relative w-full md:w-auto flex flex-col md:flex-row gap-4 md:items-center">
      <div class="relative w-full md:w-80">
        <input type="text" placeholder="Buscar por título, autor o etiqueta..." class="w-full bg-[var(--color-background)] border-2 border-[var(--color-foreground)] px-4 py-2 text-sm font-medium focus:outline-none focus:ring-4 focus:ring-[var(--color-secondary)] transition-all rounded-none" />
        <button class="absolute right-0 top-0 bottom-0 bg-[var(--color-foreground)] text-white px-4 hover:bg-[var(--color-primary)] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </button>
      </div>
      <a href="/biblioteca/subir" class="bg-[var(--color-primary)] text-white px-4 py-2 text-sm font-black uppercase tracking-widest border-2 border-[var(--color-primary)] hover:bg-white hover:text-[var(--color-primary)] hover:border-[var(--color-primary)] transition-all shadow-[4px_4px_0px_0px_var(--color-foreground)] active:translate-y-1 active:translate-x-1 active:shadow-none whitespace-nowrap text-center">
        + Subir Documento
      </a>
    </div>
  </div>

  <div class="mt-8">
    <!-- Filtros / Categorías (Opcional a futuro) -->
    <div class="mb-6 flex gap-2 overflow-x-auto pb-2">
      <span class="bg-[var(--color-foreground)] text-white text-xs font-bold px-3 py-1 uppercase tracking-widest cursor-pointer whitespace-nowrap">Todos</span>
      <span class="bg-[var(--color-secondary)] text-[var(--color-foreground)] border border-[var(--color-foreground)] text-xs font-bold px-3 py-1 uppercase tracking-widest cursor-pointer whitespace-nowrap hover:bg-[var(--color-foreground)] hover:text-white transition-colors">Resoluciones</span>
      <span class="bg-[var(--color-secondary)] text-[var(--color-foreground)] border border-[var(--color-foreground)] text-xs font-bold px-3 py-1 uppercase tracking-widest cursor-pointer whitespace-nowrap hover:bg-[var(--color-foreground)] hover:text-white transition-colors">Material de Estudio</span>
      <span class="bg-[var(--color-secondary)] text-[var(--color-foreground)] border border-[var(--color-foreground)] text-xs font-bold px-3 py-1 uppercase tracking-widest cursor-pointer whitespace-nowrap hover:bg-[var(--color-foreground)] hover:text-white transition-colors">Actas</span>
    </div>

    <!-- Grid de Documentos -->
    {documents.length === 0 ? (
      <div class="text-center py-16 border-4 border-dashed border-[var(--color-border)] bg-[var(--color-secondary)]">
        <p class="font-black text-[var(--color-muted-foreground)] uppercase tracking-widest text-lg">No hay documentos en la biblioteca</p>
        <p class="text-sm font-bold text-gray-500 mt-2">Los administradores aún no han subido material.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {documents.map(({ doc, author }) => (
          <a href={`/biblioteca/${doc.id}`} class="group border-4 border-[var(--color-foreground)] bg-white flex flex-col hover:shadow-[8px_8px_0px_0px_var(--color-primary)] hover:-translate-y-1 transition-all relative h-full">
            {user && user.baseClearance < doc.clearanceLevel && (
              <div class="absolute inset-0 bg-black/90 z-20 flex flex-col items-center justify-center text-white p-4 text-center">
                <span class="text-4xl mb-2">🔒</span>
                <span class="font-black text-sm uppercase tracking-widest text-red-500">Acceso Denegado</span>
                <span class="text-[10px] font-bold uppercase mt-2 bg-red-900 px-2 py-1">Requiere Nivel {doc.clearanceLevel}</span>
              </div>
            )}
            
            <!-- "Tapa" del Documento -->
            <div class="aspect-[3/4] bg-[var(--color-secondary)] p-4 flex flex-col justify-between border-b-4 border-[var(--color-foreground)] group-hover:bg-yellow-100 transition-colors relative overflow-hidden">
              <div class="absolute -right-8 -top-8 text-black opacity-5 text-9xl font-black rotate-12">{doc.category.charAt(0)}</div>
              
              <div class="flex justify-between items-start relative z-10">
                <span class="text-[10px] font-black uppercase tracking-widest text-white bg-[var(--color-primary)] border-2 border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-foreground)] px-2 py-1">
                  Nivel {doc.clearanceLevel}
                </span>
                <span class="text-[10px] font-black uppercase tracking-widest text-[var(--color-foreground)] bg-white border-2 border-[var(--color-foreground)] px-2 py-1">
                  {doc.category}
                </span>
              </div>
              
              <h3 class="font-black text-2xl uppercase tracking-tighter leading-none mt-4 relative z-10 text-[var(--color-foreground)]">{doc.title}</h3>
            </div>
            
            <!-- Metadata -->
            <div class="p-4 flex flex-col justify-between flex-1 bg-white">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 bg-[var(--color-foreground)] border-2 border-black flex items-center justify-center text-white font-black text-[10px] uppercase">
                  {(author?.name || 'U').charAt(0)}{(author?.lastName || 'S').charAt(0)}
                </div>
                <div class="flex flex-col">
                  <span class="text-[10px] font-black text-gray-500 uppercase tracking-widest leading-none">Subido por</span>
                  <span class="text-xs font-bold text-[var(--color-foreground)] leading-tight">{author ? `${author.name} ${author.lastName}` : 'Sistema'}</span>
                </div>
              </div>
              
              <div class="flex justify-between items-center pt-3 border-t-2 border-dashed border-gray-300">
                <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">
                  {new Date(doc.createdAt).toLocaleDateString('es-CL')}
                </span>
                <span class="text-[10px] font-black text-[var(--color-primary)] uppercase flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  LEER <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</AppLayout>
