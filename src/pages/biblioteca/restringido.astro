---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { documentTable, organizationTable, accessRequestTable, notificationTable, userTable } from '../../db/schema';
import { eq, and } from 'drizzle-orm';
import crypto from 'crypto';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/');
}

const docId = Astro.url.searchParams.get('id');
if (!docId) {
  return Astro.redirect('/biblioteca');
}

const doc = await db.select().from(documentTable).where(eq(documentTable.id, docId)).get();
if (!doc) {
  return new Response('Documento no encontrado', { status: 404 });
}

const org = await db.select().from(organizationTable).where(eq(organizationTable.id, doc.organizationId)).get();

let hasPendingRequest = false;
let successMessage = '';
let errorMessage = '';

// Verificar si ya tiene solicitud
const existingReq = await db.select().from(accessRequestTable)
  .where(
    and(
      eq(accessRequestTable.documentId, docId),
      eq(accessRequestTable.requesterUserId, user.id)
    )
  ).get();

if (existingReq) {
  if (existingReq.status === 'pending') {
    hasPendingRequest = true;
  } else if (existingReq.status === 'approved') {
    return Astro.redirect(`/biblioteca/${docId}`); // Ya se aprobó, mandarlo de vuelta
  }
}

if (Astro.request.method === 'POST') {
  if (hasPendingRequest) {
    errorMessage = 'Ya tienes una solicitud pendiente para este documento.';
  } else {
    // 1. Crear solicitud
    await db.insert(accessRequestTable).values({
      id: crypto.randomUUID(),
      documentId: docId,
      requesterUserId: user.id,
      status: 'pending'
    });
    
    hasPendingRequest = true;
    successMessage = 'Solicitud enviada exitosamente a la mesa directiva.';
  }
}
---

<AppLayout title="Acceso Restringido | Biblioteca">
  <div class="max-w-2xl mx-auto py-20 px-4">
    
    <div class="border-4 border-[var(--color-foreground)] bg-[var(--color-background)] p-8 text-center relative overflow-hidden shadow-[12px_12px_0px_0px_var(--color-primary)]">
      
      <!-- Icono Restringido -->
      <div class="w-24 h-24 mx-auto border-4 border-[var(--color-foreground)] bg-[var(--color-secondary)] flex items-center justify-center text-4xl mb-8 transform -rotate-3">
        🔒
      </div>

      <h1 class="text-4xl font-black uppercase tracking-tighter mb-4 text-[var(--color-foreground)]">Acceso Restringido</h1>
      
      <p class="text-lg font-bold text-[var(--color-muted-foreground)] mb-8">
        Este documento es de uso interno o confidencial. Pertenece a <br/>
        <span class="text-[var(--color-foreground)] bg-[var(--color-secondary)] px-2 py-1 uppercase tracking-widest text-sm border-2 border-[var(--color-foreground)] mt-2 inline-block">
          {org?.name || 'Organización Desconocida'}
        </span>
      </p>

      {successMessage && (
        <div class="mb-8 p-4 border-4 border-green-600 bg-green-100 text-green-900 font-bold uppercase tracking-widest text-sm">
          {successMessage}
        </div>
      )}

      {errorMessage && (
        <div class="mb-8 p-4 border-4 border-red-600 bg-red-100 text-red-900 font-bold uppercase tracking-widest text-sm">
          {errorMessage}
        </div>
      )}

      {hasPendingRequest ? (
        <div class="bg-[var(--color-secondary)] border-2 border-[var(--color-foreground)] p-6 inline-block">
          <p class="font-black uppercase tracking-widest text-sm">Tu solicitud está en revisión</p>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-2">La mesa directiva evaluará tu petición.</p>
        </div>
      ) : (
        <form method="POST">
          <button type="submit" class="bg-[var(--color-primary)] text-white text-lg font-black uppercase tracking-widest px-8 py-4 border-4 border-[var(--color-foreground)] hover:bg-[var(--color-foreground)] transition-colors shadow-[6px_6px_0px_0px_var(--color-foreground)] active:translate-y-1 active:translate-x-1 active:shadow-none">
            Solicitar Acceso a la Mesa Directiva
          </button>
        </form>
      )}

      <div class="mt-12 text-sm font-bold">
        <a href="/biblioteca" class="text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] uppercase tracking-widest underline decoration-2 underline-offset-4">
          Volver a la Biblioteca
        </a>
      </div>

    </div>

  </div>
</AppLayout>
