---
import AuthLayout from '../layouts/AuthLayout.astro';
import { db } from '../db';
import { userTable } from '../db/schema';
import { eq } from 'drizzle-orm';
import bcrypt from 'bcryptjs';
import { lucia } from '../lib/auth';
import crypto from 'node:crypto';
import { cleanRut } from '../lib/rut';

// Redirigir si ya está autenticado
if (Astro.locals.user) {
  return Astro.redirect('/perfil');
}

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const identifier = formData.get('identifier');
    const password = formData.get('password');

    if (typeof identifier !== 'string' || typeof password !== 'string') {
      errorMessage = 'Campos inválidos';
    } else {
      // Buscar usuario (por Email o por RUT Hash)
      const isEmail = identifier.includes('@');
      
      let existingUser;
      if (isEmail) {
        [existingUser] = await db.select().from(userTable).where(eq(userTable.email, identifier.trim().toLowerCase()));
      } else {
        const cleanedRut = cleanRut(identifier);
        const pepper = import.meta.env.BLIND_INDEX_PEPPER || 'default-pepper-123';
        const rutHash = crypto.createHash('sha256').update(cleanedRut + pepper).digest('hex');
        [existingUser] = await db.select().from(userTable).where(eq(userTable.rutHash, rutHash));
      }
      
      if (!existingUser) {
        errorMessage = 'Credenciales incorrectas';
      } else {
        const validPassword = await bcrypt.compare(password, existingUser.passwordHash);
        if (!validPassword) {
          errorMessage = 'Credenciales incorrectas';
        } else {
          const session = await lucia.createSession(existingUser.id, {});
          const sessionCookie = lucia.createSessionCookie(session.id);
          Astro.cookies.set(sessionCookie.name, sessionCookie.value, sessionCookie.attributes);
          return Astro.redirect('/perfil');
        }
      }
    }
  } catch (e) {
    console.error(e);
    errorMessage = 'Error en el formato de la petición.';
  }
}
---

<AuthLayout title="Iniciar Sesión">
  <div class="w-full max-w-md mx-auto">
    <!-- Header Formulario -->
    <div class="mb-10">
      <h2 class="text-4xl font-black uppercase tracking-tight mb-2 leading-none">Acceso<br/>Central</h2>
      <p class="text-[var(--color-muted-foreground)] font-bold uppercase tracking-widest text-xs border-l-4 border-[var(--color-primary)] pl-3 mt-4">Portal de Militancia</p>
    </div>

    {errorMessage && (
      <div class="bg-red-100 border-2 border-red-500 text-red-700 px-4 py-3 font-bold text-sm mb-6 uppercase tracking-widest">
        {errorMessage}
      </div>
    )}

    <!-- Formulario -->
    <form method="POST" enctype="application/x-www-form-urlencoded" class="space-y-6">
      
      <div class="space-y-2">
        <label for="identifier" class="block text-xs font-black uppercase tracking-widest">Correo Electrónico o RUT</label>
        <input 
          type="text" 
          id="identifier" 
          name="identifier"
          placeholder="tu@correo.cl o 11111111-1" 
          required
          class="w-full border-2 border-[var(--color-foreground)] bg-[var(--color-background)] px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none placeholder:text-gray-300"
        />
      </div>

      <div class="space-y-2">
        <div class="flex justify-between items-end">
          <label for="password" class="block text-xs font-black uppercase tracking-widest">Contraseña</label>
          <a href="#" class="text-[10px] font-bold text-[var(--color-primary)] uppercase hover:underline">¿Olvidaste tu clave?</a>
        </div>
        <input 
          type="password" 
          id="password" 
          name="password"
          placeholder="••••••••" 
          required
          class="w-full border-2 border-[var(--color-foreground)] bg-[var(--color-background)] px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none placeholder:text-gray-300"
        />
      </div>

      <button type="submit" class="w-full bg-[var(--color-foreground)] text-[var(--color-background)] font-black uppercase tracking-widest py-4 mt-6 hover:bg-[var(--color-primary)] transition-colors border-2 border-[var(--color-foreground)] shadow-[6px_6px_0px_0px_var(--color-primary)] active:translate-y-1 active:translate-x-1 active:shadow-[2px_2px_0px_0px_var(--color-primary)]">
        Iniciar Sesión
      </button>

    </form>

    <div class="mt-12 pt-8 border-t-2 border-dashed border-[var(--color-border)] text-center">
      <p class="text-sm font-bold text-[var(--color-muted-foreground)]">¿No tienes cuenta digital activa?</p>
      <a href="/validacion" class="inline-block mt-4 text-xs font-black uppercase tracking-widest text-[var(--color-primary)] border-2 border-[var(--color-primary)] px-6 py-4 hover:bg-[var(--color-primary)] hover:text-white transition-colors w-full">
        Validar Padrón y Crear Cuenta
      </a>
    </div>

  </div>
</AuthLayout>
