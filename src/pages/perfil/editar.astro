---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { userTable } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

// Obtener datos más recientes de la DB
const [dbUser] = await db.select().from(userTable).where(eq(userTable.id, user.id));

let message = '';
let isError = false;

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get('name') as string;
    const lastName = formData.get('lastName') as string;
    const email = formData.get('email') as string;
    const biography = formData.get('biography') as string;
    const phone = formData.get('phone') as string;
    const avatar = formData.get('avatar');

    let newAvatarUrl = dbUser.avatarUrl;

    if (avatar && avatar instanceof File && avatar.size > 0) {
      try {
        // Subida de imágenes local deshabilitada temporalmente por compatibilidad con Cloudflare Pages.
        // TODO: Migrar a Cloudflare R2 u otro bucket S3.
        newAvatarUrl = dbUser.avatarUrl;
      } catch (uploadErr) {
        console.error('Error procesando avatar:', uploadErr);
      }
    }

    try {
    await db.update(userTable).set({
      name,
      lastName,
      email: email ? email.toLowerCase() : null,
      biography,
      phone,
      avatarUrl: newAvatarUrl
    }).where(eq(userTable.id, user.id));
    
    message = 'Ficha actualizada exitosamente.';
    isError = false;
    
    // Refresh dbUser local
    dbUser.name = name;
    dbUser.lastName = lastName;
    dbUser.email = email ? email.toLowerCase() : null;
    dbUser.biography = biography;
    dbUser.phone = phone;
    dbUser.avatarUrl = newAvatarUrl;
  } catch (err) {
    message = 'Error al actualizar la ficha.';
    isError = true;
  }
  } catch (e) {
    console.error(e);
    message = 'Error procesando la solicitud.';
    isError = true;
  }
}
---

<AppLayout title="Editar Ficha Militante">
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-8 border-b-4 border-[var(--color-foreground)] pb-6 flex items-center justify-between">
      <div>
        <a href="/perfil" class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] flex items-center gap-2 mb-4">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Volver al Perfil
        </a>
        <h1 class="text-4xl font-black uppercase tracking-tight text-[var(--color-foreground)]">Actualización de<br/>Ficha Orgánica</h1>
      </div>
    </div>

    {message && (
      <div class={`px-4 py-3 font-bold text-sm mb-6 uppercase tracking-widest border-2 ${isError ? 'bg-red-100 border-red-500 text-red-700' : 'bg-[#FFFDF5] border-[var(--color-primary)] text-[var(--color-foreground)] shadow-[4px_4px_0px_0px_var(--color-primary)]'}`}>
        {message}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Columna Lateral: Estado Orgánico (Solo Lectura) -->
      <aside class="md:col-span-1 space-y-6">
        <div class="bg-[var(--color-secondary)] p-6 border-2 border-[var(--color-border)]">
          <h3 class="text-sm font-black uppercase tracking-widest mb-4 border-b-2 border-[var(--color-border)] pb-2 text-[var(--color-primary)]">Estado Orgánico</h3>
          <p class="text-xs font-medium text-[var(--color-muted-foreground)] mb-4">Los datos orgánicos son de solo lectura. Su modificación requiere resolución de la dirección correspondiente.</p>
          
          <div class="space-y-4">
            <div>
              <label class="block text-[10px] font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]">Comuna Base</label>
              <div class="font-bold text-sm bg-white p-2 border border-[var(--color-border)] mt-1">Santiago Centro</div>
            </div>
            <div>
              <label class="block text-[10px] font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]">Estado Padrón</label>
              <div class="font-bold text-sm bg-green-100 text-green-800 p-2 border border-green-300 mt-1 uppercase tracking-widest text-center">{dbUser.isActive ? 'Activo / Al Día' : 'Inactivo'}</div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Formulario Principal -->
      <div class="md:col-span-2 space-y-8">
        
        <form method="POST" enctype="multipart/form-data" class="space-y-8">
          
          <!-- Sección Fotografía -->
          <section class="space-y-6">
            <h2 class="text-xl font-black uppercase tracking-tight border-l-4 border-[var(--color-primary)] pl-3">Fotografía Institucional</h2>
            
            <div class="flex flex-col md:flex-row items-start gap-6 bg-[var(--color-secondary)] p-6 border-2 border-[var(--color-border)]">
              <!-- Preview -->
              <div class="w-32 h-32 bg-[var(--color-background)] rounded-none p-1 flex-shrink-0 border-2 border-white shadow-[4px_4px_0px_0px_var(--color-primary)] overflow-hidden">
                {dbUser.avatarUrl ? (
                  <img src={dbUser.avatarUrl} alt="Avatar actual" class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full bg-gray-400 flex items-center justify-center text-4xl font-black text-white uppercase">
                    {(dbUser.name || 'U').charAt(0)}{(dbUser.lastName || 'S').charAt(0)}
                  </div>
                )}
              </div>
              
              <div class="space-y-4 flex-1 w-full">
                <p class="text-xs font-medium text-[var(--color-muted-foreground)]">Sube una fotografía de frente. El sistema la recortará automáticamente en formato cuadrado y la optimizará usando compresión WebP para máxima velocidad.</p>
                <div class="relative">
                  <input type="file" id="avatar" name="avatar" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                  <div class="bg-[var(--color-background)] border-2 border-dashed border-[var(--color-foreground)] px-4 py-4 text-center font-bold text-sm uppercase tracking-widest hover:bg-[var(--color-secondary)] transition-colors cursor-pointer relative z-0">
                    Seleccionar Archivo (JPG, PNG)
                  </div>
                </div>
              </div>
            </div>
          </section>

          <hr class="border-2 border-dashed border-[var(--color-border)]" />

          <section class="space-y-6">
            <h2 class="text-xl font-black uppercase tracking-tight border-l-4 border-[var(--color-primary)] pl-3">Datos Personales</h2>
            
            <div class="grid grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="block text-xs font-bold uppercase tracking-widest">Nombres</label>
                <input type="text" id="name" name="name" value={dbUser.name} required class="w-full border-2 border-[var(--color-foreground)] px-4 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)]" />
              </div>
              <div class="space-y-2">
                <label for="lastName" class="block text-xs font-bold uppercase tracking-widest">Apellidos</label>
                <input type="text" id="lastName" name="lastName" value={dbUser.lastName} required class="w-full border-2 border-[var(--color-foreground)] px-4 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)]" />
              </div>
            </div>

            <div class="space-y-2">
              <label for="biography" class="block text-xs font-bold uppercase tracking-widest">Biografía Política / Presentación</label>
              <textarea id="biography" name="biography" rows="4" class="w-full border-2 border-[var(--color-foreground)] px-4 py-3 font-medium text-sm focus:outline-none focus:border-[var(--color-primary)]">{dbUser.biography || ''}</textarea>
              <p class="text-[10px] uppercase font-bold text-[var(--color-muted-foreground)]">Visible para otros militantes en los foros y documentos que publiques.</p>
            </div>
          </section>

          <hr class="border-2 border-dashed border-[var(--color-border)]" />

          <section class="space-y-6">
            <h2 class="text-xl font-black uppercase tracking-tight border-l-4 border-[var(--color-foreground)] pl-3">Contacto Seguro</h2>
            
            <div class="space-y-2">
              <label for="email" class="block text-xs font-bold uppercase tracking-widest flex items-center gap-2">
                Correo Electrónico 
                <span class="bg-[var(--color-foreground)] text-white text-[9px] px-1.5 py-0.5 rounded-sm">Primario</span>
              </label>
              <input type="email" id="email" name="email" value={dbUser.email || ''} class="w-full border-2 border-[var(--color-foreground)] px-4 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)]" placeholder="Ingresa tu correo" />
            </div>

            <div class="space-y-2">
              <label for="phone" class="block text-xs font-bold uppercase tracking-widest">Teléfono de Contacto (Opcional)</label>
              <input type="tel" id="phone" name="phone" value={dbUser.phone || ''} class="w-full border-2 border-[var(--color-foreground)] px-4 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)]" />
            </div>
          </section>
          
          <div class="pt-6 border-t-2 border-[var(--color-foreground)] flex justify-end">
             <button type="submit" class="bg-[var(--color-foreground)] text-white px-8 py-4 font-black text-sm uppercase tracking-widest hover:bg-[var(--color-primary)] transition-colors border-2 border-[var(--color-foreground)] shadow-[6px_6px_0px_0px_var(--color-primary)] active:translate-y-1 active:translate-x-1 active:shadow-[2px_2px_0px_0px_var(--color-primary)]">
               Guardar Cambios en la Ficha
             </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</AppLayout>
