---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { appointmentTable, positionTypeTable, organizationTable } from '../../db/schema';
import { eq, and } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}

// Fetch user active appointments to show in profile
const now = new Date();
const activeAppointments = await db.select({
  position: positionTypeTable.title,
  organization: organizationTable.name,
  resolutionRef: appointmentTable.resolutionRef
})
.from(appointmentTable)
.innerJoin(positionTypeTable, eq(appointmentTable.positionTypeId, positionTypeTable.id))
.innerJoin(organizationTable, eq(appointmentTable.organizationId, organizationTable.id))
.where(
  and(
    eq(appointmentTable.userId, user.id),
    eq(appointmentTable.status, 'activo')
  )
)
.all();

---

<AppLayout title="Mi Perfil">
  <div class="max-w-5xl mx-auto">
    
    <!-- Ficha Principal (Header del Perfil) -->
    <div class="bg-[var(--color-foreground)] text-white p-8 md:p-12 rounded-none border-2 border-[var(--color-foreground)] shadow-[8px_8px_0px_0px_var(--color-primary)] relative overflow-hidden mb-8">
      
      <div class="relative z-10 flex flex-col md:flex-row items-center md:items-end gap-8">
        
        <!-- Avatar Grande -->
        <div class="w-32 h-32 md:w-40 md:h-40 bg-[var(--color-background)] rounded-none p-1 flex-shrink-0 border-2 border-white shadow-[4px_4px_0px_0px_var(--color-primary)] overflow-hidden">
          {user.avatarUrl ? (
            <img src={user.avatarUrl} alt={`Avatar de ${user.name}`} class="w-full h-full object-cover" />
          ) : (
            <div class="w-full h-full bg-gray-400 rounded-none flex items-center justify-center text-4xl font-black text-white uppercase">
              {(user.name || 'U').charAt(0)}{(user.lastName || 'S').charAt(0)}
            </div>
          )}
        </div>
        
        <div class="flex-1 text-center md:text-left">
          <div class="flex flex-col md:flex-row md:items-center gap-4 mb-2">
            <h1 class="text-4xl font-black uppercase tracking-tight">{user.name} {user.lastName}</h1>
            <span class="bg-[var(--color-primary)] text-white text-[10px] font-black px-2 py-1 uppercase tracking-widest rounded-none border border-[var(--color-primary)]">
              {user.isActive ? 'Militante Activo' : 'Cuenta Inactiva'}
            </span>
          </div>
          
          <div class="mb-4 space-y-1 mt-4">
            {activeAppointments.length > 0 ? activeAppointments.map(app => (
               <p class="text-sm font-black text-yellow-400 uppercase tracking-widest bg-black/30 inline-block px-3 py-1 border border-yellow-400/50 mr-2 mb-2">
                 {app.position} • {app.organization}
                 {app.resolutionRef && <span class="block text-[8px] text-gray-300">Ref: {app.resolutionRef}</span>}
               </p>
            )) : (
               <p class="text-sm font-bold text-gray-400 uppercase tracking-widest">Sin Cargos Vigentes</p>
            )}
          </div>
          
          <!-- Acción Principal -->
          <div class="mt-6 md:mt-0">
            <a href="/perfil/editar" class="inline-block bg-[var(--color-background)] text-[var(--color-foreground)] px-6 py-3 text-sm font-black uppercase tracking-widest rounded-none hover:bg-gray-200 transition-colors shadow-[4px_4px_0px_0px_rgba(200,16,46,1)] border-2 border-[var(--color-foreground)] active:translate-y-1 active:translate-x-1 active:shadow-[0px_0px_0px_0px_rgba(200,16,46,1)]">
              Editar Ficha
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Información y Comisiones (1/3) -->
      <div class="space-y-8">
        
        <!-- Comisiones -->
        <section class="border-2 border-[var(--color-foreground)] bg-[#FFFDF5] p-6 rounded-none">
          <h3 class="text-xs font-black text-[var(--color-foreground)] uppercase tracking-widest border-b-2 border-[var(--color-border)] pb-2 mb-4">Comisiones Activas</h3>
          <ul class="space-y-3">
            <li class="flex items-center gap-3">
              <div class="w-3 h-3 border-2 border-[var(--color-foreground)] bg-[var(--color-primary)]"></div>
              <span class="text-xs font-bold uppercase tracking-widest">Comisión Política</span>
            </li>
            <li class="flex items-center gap-3">
              <div class="w-3 h-3 border-2 border-[var(--color-foreground)] bg-white"></div>
              <span class="text-xs font-bold uppercase tracking-widest">Frente Estudiantil</span>
            </li>
          </ul>
        </section>

        <!-- Insignias / Reconocimientos -->
        <section class="border-2 border-[var(--color-foreground)] bg-[var(--color-secondary)] p-6 rounded-none">
          <h3 class="text-xs font-black text-[var(--color-foreground)] uppercase tracking-widest border-b-2 border-[var(--color-border)] pb-2 mb-4">Insignias Formativas</h3>
          <div class="flex flex-wrap gap-2">
            <!-- Badge -->
            <div class="px-3 py-1.5 bg-[var(--color-foreground)] text-white text-[9px] uppercase font-black tracking-widest rounded-none shadow-[2px_2px_0px_0px_var(--color-primary)]">
              Formación Básica
            </div>
            <div class="px-3 py-1.5 bg-white text-[var(--color-foreground)] text-[9px] uppercase font-black tracking-widest rounded-none border-2 border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-border)]">
              Liderazgo 2023
            </div>
          </div>
        </section>
        
      </div>

      <!-- Actividad y Cursos (2/3) -->
      <div class="md:col-span-2 space-y-8">
        
        <!-- Tabs (Brutalistas) -->
        <div class="flex border-b-4 border-[var(--color-foreground)]">
          <button class="px-6 py-3 font-black text-sm uppercase tracking-widest border-t-4 border-l-4 border-r-4 border-[var(--color-foreground)] bg-[var(--color-primary)] text-white -mb-1 relative z-10">Actividad Reciente</button>
          <button class="px-6 py-3 font-bold text-xs uppercase tracking-widest text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors">Cursos Aprobados</button>
        </div>
        
        <!-- Lista de Actividad (Timeline simple) -->
        <div class="relative pl-6 border-l-4 border-[var(--color-border)] space-y-8 ml-2 mt-8">
          
          <!-- Item Timeline -->
          <div class="relative">
            <div class="absolute -left-[30px] top-1 w-4 h-4 bg-[var(--color-primary)] rounded-none border-2 border-[var(--color-foreground)]"></div>
            <div class="text-[10px] text-[var(--color-foreground)] font-black uppercase tracking-widest mb-1">Ayer, 18:30</div>
            <p class="text-sm font-medium">Subió un nuevo documento: <a href="#" class="font-black hover:text-[var(--color-primary)] uppercase underline decoration-2">Acta Asamblea Comunal.pdf</a> en la Biblioteca central.</p>
          </div>
          
          <!-- Item Timeline -->
          <div class="relative">
            <div class="absolute -left-[30px] top-1 w-4 h-4 bg-white rounded-none border-2 border-[var(--color-foreground)]"></div>
            <div class="text-[10px] text-[var(--color-foreground)] font-black uppercase tracking-widest mb-1">12 Octubre 2023</div>
            <p class="text-sm font-medium">Completó el módulo <span class="font-black uppercase">"La Cuestión Social"</span> del curso <span class="italic font-bold">Historia del Movimiento Obrero</span>.</p>
          </div>
          
        </div>
        
      </div>
    </div>
  </div>
</AppLayout>
