---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { roleRequestTable, organizationTable, userTable, appointmentTable, positionTypeTable } from '../../db/schema';
import { eq, inArray, and } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/');
}

// 1. Obtener organizaciones donde el usuario tiene un rol de directiva/secretariado
const myDirectives = await db.select({
  orgId: appointmentTable.organizationId
}).from(appointmentTable)
  .innerJoin(positionTypeTable, eq(appointmentTable.positionTypeId, positionTypeTable.id))
  .where(
    and(
      eq(appointmentTable.userId, user.id),
      eq(appointmentTable.status, 'activo'),
      inArray(positionTypeTable.functionalArea, ['presidencia', 'politico', 'organico', 'general'])
    )
  ).all();

const orgIds = myDirectives.map(d => d.orgId);

// Si no es parte de ningún secretariado, no puede ver esto
if (orgIds.length === 0) {
  return Astro.redirect('/espacios');
}

// 2. Obtener solicitudes pendientes para esas organizaciones
const requests = await db.select({
  request: roleRequestTable,
  user: userTable,
  org: organizationTable
}).from(roleRequestTable)
  .innerJoin(userTable, eq(roleRequestTable.requesterUserId, userTable.id))
  .innerJoin(organizationTable, eq(roleRequestTable.organizationId, organizationTable.id))
  .where(
    and(
      eq(roleRequestTable.status, 'pending'),
      inArray(roleRequestTable.organizationId, orgIds)
    )
  ).all();

---

<AppLayout title="Panel de Secretariado">
  <div class="mb-8 flex justify-between items-end border-b border-[var(--color-foreground)] pb-6">
    <div>
      <h1 class="text-4xl font-bold text-[var(--color-foreground)] uppercase tracking-tighter">Secretariado</h1>
      <p class="text-[var(--color-muted-foreground)] mt-2 font-bold uppercase tracking-widest text-xs">Gestión de Solicitudes de Ingreso</p>
    </div>
    <a href="/espacios" class="text-xs font-black uppercase tracking-widest border-2 border-[var(--color-foreground)] px-4 py-2 hover:bg-[var(--color-foreground)] hover:text-white transition-colors">
      Volver a Mis Espacios
    </a>
  </div>

  <div class="space-y-6 max-w-4xl">
    {requests.length === 0 ? (
      <div class="p-8 border-4 border-dashed border-[var(--color-foreground)] bg-gray-50 text-center font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest">
        No hay solicitudes pendientes en tus organizaciones
      </div>
    ) : (
      requests.map(req => (
        <div class="border-4 border-[var(--color-foreground)] bg-white p-6 shadow-[8px_8px_0px_0px_var(--color-primary)] flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 border-2 border-[var(--color-foreground)] bg-gray-200 flex-shrink-0">
              {req.user.avatarUrl ? (
                <img src={req.user.avatarUrl} alt={req.user.name} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full flex items-center justify-center font-black text-xl uppercase bg-[var(--color-secondary)]">
                  {req.user.name.charAt(0)}
                </div>
              )}
            </div>
            <div>
              <h3 class="font-black text-lg uppercase tracking-tight">{req.user.name} {req.user.lastName}</h3>
              <p class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest">
                Solicita ingresar a: <span class="text-[var(--color-primary)]">{req.org.name}</span>
              </p>
            </div>
          </div>
          <div class="flex gap-2 w-full md:w-auto mt-4 md:mt-0">
            <button class="btn-resolver flex-1 md:flex-none bg-[var(--color-foreground)] text-white font-black uppercase tracking-widest text-xs px-6 py-3 border-2 border-[var(--color-foreground)] hover:bg-[var(--color-primary)] shadow-[2px_2px_0px_0px_var(--color-foreground)] active:translate-y-0.5 active:translate-x-0.5 active:shadow-none transition-all" data-id={req.request.id} data-action="approved">
              Aprobar
            </button>
            <button class="btn-resolver flex-1 md:flex-none bg-white text-[var(--color-foreground)] font-black uppercase tracking-widest text-xs px-6 py-3 border-2 border-[var(--color-foreground)] hover:bg-gray-100 shadow-[2px_2px_0px_0px_var(--color-foreground)] active:translate-y-0.5 active:translate-x-0.5 active:shadow-none transition-all" data-id={req.request.id} data-action="rejected">
              Rechazar
            </button>
          </div>
        </div>
      ))
    )}
  </div>
</AppLayout>

<script>
  const buttons = document.querySelectorAll('.btn-resolver');

  buttons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const id = target.getAttribute('data-id');
      const action = target.getAttribute('data-action');
      
      if (!id || !action) return;
      
      target.textContent = '...';
      target.disabled = true;

      try {
        const res = await fetch('/api/solicitudes/resolver', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requestId: id, status: action })
        });
        
        if (res.ok) {
          window.location.reload();
        } else {
          alert('Error al procesar solicitud');
          target.disabled = false;
        }
      } catch (err) {
        alert('Error de conexión');
        target.disabled = false;
      }
    });
  });
</script>
