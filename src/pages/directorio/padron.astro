---
import AppLayout from '../../layouts/AppLayout.astro';
import { authorize } from '../../lib/authz';

const user = Astro.locals.user;
const canManageOrg = await authorize(user?.id, 'manage', 'organization');

if (!canManageOrg) {
  return Astro.redirect('/directorio');
}

import { db } from '../../db';
import { padronProvisorioTable } from '../../db/schema';

// Cargar Padrón de la DB
const padronDb = await db.select().from(padronProvisorioTable).all();

---

<AppLayout title="Padrón Militante">
  <div class="max-w-6xl mx-auto">
    
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between border-b-4 border-[var(--color-foreground)] pb-6 gap-6">
      <div>
        <h1 class="text-4xl md:text-5xl font-black text-[var(--color-foreground)] uppercase tracking-tighter leading-none">
          Padrón<br/>Militante
        </h1>
        <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-4">
          Registro Oficial de Miembros
        </p>
      </div>
      
      <div class="flex flex-col gap-3 w-full md:w-auto">
        <div class="relative w-full md:w-80">
          <input type="text" placeholder="Buscar por RUT, Nombre o Comuna..." class="w-full bg-[var(--color-background)] border-2 border-[var(--color-foreground)] px-4 py-3 text-sm font-bold focus:outline-none focus:ring-4 focus:ring-[var(--color-primary)] transition-all rounded-none placeholder-gray-400" />
          <svg class="absolute right-4 top-3.5 text-[var(--color-muted-foreground)]" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <button class="bg-[var(--color-primary)] text-white px-4 py-3 font-black text-xs uppercase tracking-widest border-2 border-[var(--color-foreground)] shadow-[4px_4px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all text-center">
          EXPORTAR EXCEL
        </button>
      </div>
    </div>

    <!-- Filtros de Navegación -->
    <div class="flex flex-wrap gap-4 mb-10 border-b border-[var(--color-border)] pb-4">
      <a href="/directorio" class="text-sm font-bold uppercase tracking-widest text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] bg-[var(--color-secondary)] border-2 border-[var(--color-border)] hover:border-[var(--color-foreground)] px-4 py-2 transition-colors">
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="M15 3v18"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>
          Vista Jerárquica
        </span>
      </a>
      <a href="#" class="text-sm font-black uppercase tracking-widest bg-[var(--color-foreground)] text-[var(--color-background)] px-4 py-2 border-2 border-[var(--color-foreground)]">
        <span class="inline-flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          Ver Padrón
        </span>
      </a>
    </div>

    <!-- Filtros Secundarios -->
    <div class="flex flex-wrap gap-3 mb-6">
      <select class="bg-[var(--color-background)] border-2 border-[var(--color-border)] px-4 py-2 text-xs font-bold uppercase tracking-widest text-[var(--color-foreground)] focus:outline-none focus:border-[var(--color-primary)]">
        <option>Todas las Regiones</option>
        <option>Región Metropolitana</option>
        <option>Valparaíso</option>
        <option>Biobío</option>
      </select>
      <select class="bg-[var(--color-background)] border-2 border-[var(--color-border)] px-4 py-2 text-xs font-bold uppercase tracking-widest text-[var(--color-foreground)] focus:outline-none focus:border-[var(--color-primary)]">
        <option>Estado: Todos</option>
        <option>Activo</option>
        <option>Suspendido</option>
        <option>En Evaluación</option>
      </select>
      <select class="bg-[var(--color-background)] border-2 border-[var(--color-border)] px-4 py-2 text-xs font-bold uppercase tracking-widest text-[var(--color-foreground)] focus:outline-none focus:border-[var(--color-primary)]">
        <option>Rol: Todos</option>
        <option>Militante Base</option>
        <option>Dirigente</option>
      </select>
    </div>

    <!-- Tabla Padrón -->
    <div class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] overflow-x-auto shadow-[8px_8px_0px_0px_var(--color-foreground)] mb-12">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-[var(--color-foreground)] text-[var(--color-background)] border-b-2 border-[var(--color-foreground)]">
            <th class="p-4 text-xs font-black uppercase tracking-widest">RUT</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest">Nombre Completo</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest">Región / Comuna</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest">Rol</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest text-center">Estado</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y-2 divide-[var(--color-border)]">
          {padronDb.map(militante => (
            <tr class="hover:bg-[var(--color-secondary)] transition-colors group">
              <td class="p-4">
                <span class="font-mono text-sm font-bold bg-[var(--color-muted)] px-2 py-1 border border-[var(--color-border)] group-hover:border-[var(--color-primary)] transition-colors">
                  {militante.rut}
                </span>
              </td>
              <td class="p-4">
                <div class="font-bold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">{militante.name} {militante.lastName}</div>
                <div class="text-xs text-[var(--color-muted-foreground)]">Ingreso: {militante.joinDate}</div>
              </td>
              <td class="p-4">
                <div class="font-bold text-sm">{militante.region}</div>
                <div class="text-xs text-[var(--color-muted-foreground)] uppercase tracking-wider">{militante.comuna}</div>
              </td>
              <td class="p-4">
                <span class="text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">
                  {militante.role}
                </span>
              </td>
              <td class="p-4 text-center">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-black uppercase tracking-widest border-2 ${
                  militante.status === 'Activo' 
                    ? 'border-green-600 text-green-700 bg-green-50' 
                    : militante.status === 'Suspendido'
                    ? 'border-red-600 text-red-700 bg-red-50'
                    : 'border-yellow-600 text-yellow-700 bg-yellow-50'
                }`}>
                  <span class={`w-2 h-2 rounded-full ${
                    militante.status === 'Activo' ? 'bg-green-600' : militante.status === 'Suspendido' ? 'bg-red-600' : 'bg-yellow-600'
                  }`}></span>
                  {militante.status}
                </span>
              </td>
              <td class="p-4 text-right">
                <button class="p-2 border-2 border-transparent hover:border-[var(--color-foreground)] text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors" title="Ver Perfil Completo">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
                <button class="p-2 border-2 border-transparent hover:border-[var(--color-foreground)] text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors" title="Editar Ficha">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      
      <!-- Paginación -->
      <div class="bg-[var(--color-secondary)] p-4 border-t-2 border-[var(--color-foreground)] flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]">Mostrando {padronDb.length} registros</span>
        <div class="flex gap-2">
          <button class="px-3 py-1 border-2 border-[var(--color-foreground)] bg-[var(--color-background)] hover:bg-[var(--color-foreground)] hover:text-white transition-colors text-xs font-black uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed" disabled>
            Anterior
          </button>
          <button class="px-3 py-1 border-2 border-[var(--color-foreground)] bg-[var(--color-background)] hover:bg-[var(--color-foreground)] hover:text-white transition-colors text-xs font-black uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed" disabled>
            Siguiente
          </button>
        </div>
      </div>
    </div>

  </div>
</AppLayout>
