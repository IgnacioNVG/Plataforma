---
import AppLayout from '../../../../layouts/AppLayout.astro';
import { db } from '../../../../db';
import { schoolTable, courseTable } from '../../../../db/schema';
import { eq, desc, and } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/validacion');
}

const schoolId = Astro.params.schoolId;
if (!schoolId) return Astro.redirect('/admin/escuela');

// Obtener escuela
const [school] = await db.select().from(schoolTable).where(eq(schoolTable.id, schoolId));
if (!school) return Astro.redirect('/admin/escuela');

// Manejar formulario
let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action') as string;
    
    if (action === 'edit_school') {
      const name = data.get('name') as string;
      const description = data.get('description') as string;
      const targetAudience = data.get('targetAudience') as string;
      const status = data.get('status') as 'borrador' | 'publicado';
      
      if (!name || !description) {
        error = 'Nombre y descripción son obligatorios.';
      } else {
        await db.update(schoolTable).set({
          name,
          description,
          targetAudience: targetAudience || null,
          status
        }).where(eq(schoolTable.id, schoolId));
        
        success = 'Escuela actualizada correctamente.';
        // Refrescar datos
        school.name = name;
        school.description = description;
        school.targetAudience = targetAudience || null;
        school.status = status;
      }
    } else if (action === 'delete_school') {
      // Opcional: Eliminar escuela (Solo si no tiene cursos, o cascada)
      // Por simplicidad, se podría requerir eliminar los cursos primero
      const countCourses = await db.select().from(courseTable).where(eq(courseTable.schoolId, schoolId));
      if (countCourses.length > 0) {
        error = 'No se puede eliminar la escuela porque tiene cursos asociados. Elimine los cursos primero.';
      } else {
        await db.delete(schoolTable).where(eq(schoolTable.id, schoolId));
        return Astro.redirect('/admin/escuela');
      }
    }
  } catch(e: any) {
    error = e.message || 'Error al actualizar la escuela.';
  }
}

// Obtener cursos de esta escuela
const courses = await db.select().from(courseTable).where(eq(courseTable.schoolId, schoolId)).orderBy(desc(courseTable.createdAt));

---

<AppLayout title={`Editar ${school.name}`}>
  <div class="max-w-6xl mx-auto mt-8">
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between border-b-4 border-[var(--color-foreground)] pb-6 gap-4">
      <div>
        <a href="/admin/escuela" class="text-[10px] font-black uppercase tracking-widest hover:text-[var(--color-primary)] transition-colors mb-4 block">&larr; Volver al Gestor de Escuelas</a>
        <h1 class="text-4xl font-black text-[var(--color-foreground)] uppercase tracking-tighter leading-none">Administrar Escuela</h1>
      </div>
    </div>

    {error && (
      <div class="bg-red-50 border-2 border-red-600 text-red-700 p-4 mb-8 font-bold text-sm uppercase tracking-widest shadow-[4px_4px_0px_0px_#dc2626]">
        {error}
      </div>
    )}
    
    {success && (
      <div class="bg-green-50 border-2 border-green-600 text-green-700 p-4 mb-8 font-bold text-sm uppercase tracking-widest shadow-[4px_4px_0px_0px_#16a34a]">
        {success}
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Columna Izquierda: Edición Escuela (1/3) -->
      <div class="lg:col-span-1 space-y-8">
        <form method="POST" class="bg-[var(--color-background)] border-4 border-[var(--color-foreground)] p-6 shadow-[8px_8px_0px_0px_var(--color-foreground)] space-y-6">
          <input type="hidden" name="action" value="edit_school" />
          
          <div class="space-y-2">
            <label for="name" class="block text-[10px] font-black uppercase tracking-widest text-[var(--color-foreground)]">Nombre *</label>
            <input type="text" id="name" name="name" value={school.name} required class="w-full border-2 border-[var(--color-foreground)] bg-white px-3 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)] transition-all rounded-none text-sm" />
          </div>

          <div class="space-y-2">
            <label for="description" class="block text-[10px] font-black uppercase tracking-widest text-[var(--color-foreground)]">Descripción *</label>
            <textarea id="description" name="description" required rows="4" class="w-full border-2 border-[var(--color-foreground)] bg-white px-3 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)] transition-all rounded-none text-sm">{school.description}</textarea>
          </div>

          <div class="space-y-2">
            <label for="targetAudience" class="block text-[10px] font-black uppercase tracking-widest text-[var(--color-foreground)]">Público Objetivo</label>
            <input type="text" id="targetAudience" name="targetAudience" value={school.targetAudience || ''} class="w-full border-2 border-[var(--color-foreground)] bg-white px-3 py-2 font-bold focus:outline-none focus:border-[var(--color-primary)] transition-all rounded-none text-sm" />
          </div>

          <div class="space-y-2 p-3 border-2 border-[var(--color-border)] bg-[var(--color-secondary)]">
            <label for="status" class="block text-[10px] font-black uppercase tracking-widest text-[var(--color-foreground)]">Estado</label>
            <select id="status" name="status" class="w-full border-2 border-[var(--color-foreground)] bg-white px-3 py-2 font-bold focus:outline-none rounded-none text-sm">
              <option value="borrador" selected={school.status === 'borrador'}>Borrador</option>
              <option value="publicado" selected={school.status === 'publicado'}>Publicada</option>
            </select>
          </div>

          <button type="submit" class="w-full bg-[var(--color-foreground)] text-white px-4 py-3 font-black text-xs uppercase tracking-widest border-2 border-transparent shadow-[4px_4px_0px_0px_var(--color-primary)] hover:border-[var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-primary)] transition-all">
            Guardar Cambios
          </button>
        </form>

        <!-- Formulario Eliminar -->
        <form method="POST" onsubmit="return confirm('¿Estás seguro de que deseas eliminar esta escuela? Esta acción no se puede deshacer.');" class="border-2 border-red-200 bg-red-50 p-4">
          <input type="hidden" name="action" value="delete_school" />
          <h3 class="text-xs font-black uppercase text-red-700 mb-2">Zona Peligrosa</h3>
          <p class="text-[10px] text-red-600 mb-4">Solo se puede eliminar si no tiene cursos asociados.</p>
          <button type="submit" class="w-full bg-red-600 text-white px-4 py-2 font-black text-[10px] uppercase tracking-widest border-2 border-transparent shadow-[2px_2px_0px_0px_#991b1b] hover:translate-y-px hover:translate-x-px hover:shadow-[0px_0px_0px_0px_#991b1b] transition-all" disabled={courses.length > 0}>
            Eliminar Escuela
          </button>
        </form>
      </div>

      <!-- Columna Derecha: Cursos (2/3) -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex justify-between items-center border-b-2 border-[var(--color-foreground)] pb-2 mb-6">
          <h2 class="text-2xl font-black uppercase tracking-tighter">Cursos ({courses.length})</h2>
          <a href={`/admin/escuela/${school.id}/cursos/crear`} class="bg-[var(--color-primary)] text-white px-4 py-2 font-black text-xs uppercase tracking-widest border-2 border-[var(--color-primary)] shadow-[2px_2px_0px_0px_var(--color-foreground)] hover:translate-y-px hover:translate-x-px hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all">
            + Añadir Curso
          </a>
        </div>

        {courses.length === 0 ? (
          <div class="bg-[var(--color-secondary)] border-2 border-[var(--color-border)] p-8 text-center">
            <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]">Esta escuela no tiene cursos.</p>
          </div>
        ) : (
          <div class="space-y-4">
            {courses.map(course => (
              <div class="bg-white border-2 border-[var(--color-foreground)] p-4 flex flex-col md:flex-row gap-4 items-start md:items-center justify-between group hover:shadow-[4px_4px_0px_0px_var(--color-foreground)] hover:-translate-y-1 hover:-translate-x-1 transition-all">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <span class={`text-[8px] font-black uppercase tracking-widest px-1.5 py-0.5 ${course.status === 'publicado' ? 'bg-[#16a34a] text-white' : 'bg-gray-200 text-gray-700'}`}>
                      {course.status}
                    </span>
                    {course.isMandatory && (
                      <span class="text-[8px] font-black uppercase tracking-widest text-[var(--color-primary)] border border-[var(--color-primary)] px-1.5 py-0.5">
                        Obligatorio
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg font-black uppercase"><a href={`/admin/escuela/curso/${course.id}/editar`} class="hover:text-[var(--color-primary)]">{course.title}</a></h3>
                </div>
                
                <a href={`/admin/escuela/curso/${course.id}/editar`} class="bg-[var(--color-secondary)] text-[var(--color-foreground)] px-4 py-2 font-black text-[10px] uppercase tracking-widest border border-[var(--color-foreground)] hover:bg-[var(--color-foreground)] hover:text-white transition-colors whitespace-nowrap">
                  Editar / Módulos
                </a>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>
  </div>
</AppLayout>
