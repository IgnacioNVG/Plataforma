---
import AppLayout from '../../../../../layouts/AppLayout.astro';
import { db } from '../../../../../db';
import { schoolTable, courseTable, moduleTable } from '../../../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/validacion');
}

const courseId = Astro.params.courseId;
if (!courseId) return Astro.redirect('/admin/escuela');

// Obtener curso
const [course] = await db.select().from(courseTable).where(eq(courseTable.id, courseId));
if (!course) return Astro.redirect('/admin/escuela');

// Obtener Módulos
const modules = await db.select().from(moduleTable).where(eq(moduleTable.courseId, courseId)).orderBy(moduleTable.order);

let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action') as string;

    if (action === 'update_course') {
      const title = data.get('title') as string;
      const description = data.get('description') as string;
      const isMandatory = data.get('isMandatory') === 'on';
      const status = data.get('status') as 'borrador' | 'publicado';

      if (!title || !description) {
        error = 'Título y descripción son obligatorios.';
      } else {
        await db.update(courseTable).set({
          title,
          description,
          isMandatory,
          status
        }).where(eq(courseTable.id, courseId));
        
        success = 'Curso actualizado correctamente.';
        // Recargar datos
        course.title = title;
        course.description = description;
        course.isMandatory = isMandatory;
        course.status = status;
      }
    } else if (action === 'delete_module') {
      const moduleId = data.get('moduleId') as string;
      if (moduleId) {
        await db.delete(moduleTable).where(eq(moduleTable.id, moduleId));
        success = 'Módulo eliminado.';
        return Astro.redirect(`/admin/escuela/curso/${courseId}/editar`); // Recargar para limpiar vista
      }
    }
  } catch (e: any) {
    error = e.message || 'Error al procesar la solicitud.';
  }
}
---

<AppLayout title={`Editar: ${course.title}`}>
  <div class="max-w-6xl mx-auto mt-8">
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between border-b-4 border-[var(--color-foreground)] pb-6 gap-4">
      <div>
        <a href={`/admin/escuela/${course.schoolId}/editar`} class="text-[10px] font-black uppercase tracking-widest hover:text-[var(--color-primary)] transition-colors mb-4 block">&larr; Volver a la Escuela</a>
        <h1 class="text-4xl font-black text-[var(--color-foreground)] uppercase tracking-tighter leading-none">Administrar Curso</h1>
        <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-4 flex items-center gap-2">
          {course.title}
          <span class={`text-[10px] px-2 py-0.5 ${course.status === 'publicado' ? 'bg-[#16a34a] text-white' : 'bg-gray-200 text-gray-700'}`}>{course.status}</span>
        </p>
      </div>
      <div class="flex gap-2">
        <a href="/admin/escuela" class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] px-4 py-2 font-black text-sm uppercase tracking-widest hover:bg-[var(--color-foreground)] hover:text-white transition-colors">
          &larr; Volver
        </a>
        <a href={`/escuela/${course.id}`} class="bg-[var(--color-secondary)] border-2 border-[var(--color-foreground)] px-4 py-2 font-black text-sm uppercase tracking-widest hover:bg-[var(--color-foreground)] hover:text-white transition-colors" target="_blank">
          Ver como Alumno
        </a>
      </div>
    </div>

    {error && (
      <div class="bg-red-50 border-2 border-red-600 text-red-700 p-4 mb-8 font-bold text-sm uppercase tracking-widest shadow-[4px_4px_0px_0px_#dc2626]">
        {error}
      </div>
    )}

    {success && (
      <div class="bg-green-50 border-2 border-green-600 text-green-700 p-4 mb-8 font-bold text-sm uppercase tracking-widest shadow-[4px_4px_0px_0px_#16a34a]">
        {success}
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Panel de Edición de Curso (1/3) -->
      <div class="lg:col-span-1">
        <form method="POST" class="bg-[var(--color-background)] border-4 border-[var(--color-foreground)] p-6 shadow-[8px_8px_0px_0px_var(--color-foreground)] space-y-6">
          <input type="hidden" name="action" value="update_course" />
          
          <div class="space-y-2">
            <label for="title" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Título del Curso *</label>
            <input type="text" id="title" name="title" value={course.title} required class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none" />
          </div>

          <div class="space-y-2">
            <label for="description" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Descripción Breve *</label>
            <textarea id="description" name="description" required rows="4" class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none">{course.description}</textarea>
          </div>

          <div class="flex flex-col gap-6 p-4 border-2 border-[var(--color-border)] bg-[var(--color-secondary)]">
            <div class="space-y-2">
              <label class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Carácter del Curso</label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="isMandatory" checked={course.isMandatory} class="w-5 h-5 accent-[var(--color-primary)] border-2 border-[var(--color-foreground)]" />
                <span class="font-bold text-sm">Obligatorio</span>
              </label>
            </div>
            
            <div class="space-y-2">
              <label for="status" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Estado de Publicación</label>
              <select id="status" name="status" class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-2 font-bold focus:outline-none rounded-none">
                <option value="borrador" selected={course.status === 'borrador'}>Borrador (No visible)</option>
                <option value="publicado" selected={course.status === 'publicado'}>Publicado (Visible en Catálogo)</option>
              </select>
            </div>
          </div>

          <div class="pt-4 border-t-2 border-[var(--color-border)]">
            <button type="submit" class="bg-[var(--color-foreground)] text-white px-6 py-3 font-black text-xs uppercase tracking-widest border-2 border-transparent hover:border-[var(--color-foreground)] shadow-[4px_4px_0px_0px_var(--color-primary)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-primary)] transition-all">
              Guardar Cambios
            </button>
          </div>
        </form>
      </div>

      <!-- Columna Derecha: Módulos (2/3) -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex justify-between items-center border-b-2 border-[var(--color-foreground)] pb-2 mb-6">
          <h2 class="text-2xl font-black uppercase tracking-tighter">Módulos ({modules.length})</h2>
          <a href={`/admin/escuela/curso/${courseId}/modulos/crear`} class="bg-[var(--color-primary)] text-white px-4 py-2 font-black text-xs uppercase tracking-widest border-2 border-[var(--color-primary)] shadow-[2px_2px_0px_0px_var(--color-foreground)] hover:translate-y-px hover:translate-x-px hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all">
            + Añadir Módulo
          </a>
        </div>

        {modules.length === 0 ? (
          <div class="bg-[var(--color-secondary)] p-4 text-center border-2 border-dashed border-[var(--color-border)]">
            <p class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest">Sin módulos</p>
          </div>
        ) : (
          <ul class="space-y-3">
            {modules.map((mod, idx) => (
              <li class="border-2 border-[var(--color-foreground)] bg-white p-3 shadow-[4px_4px_0px_0px_var(--color-foreground)] group">
                <div class="flex justify-between items-start mb-1">
                  <span class="text-[9px] font-black uppercase tracking-widest text-[var(--color-primary)]">Módulo {idx + 1}</span>
                  
                  <form method="POST" class="inline" onsubmit="return confirm('¿Seguro que deseas eliminar este módulo?');">
                    <input type="hidden" name="action" value="delete_module" />
                    <input type="hidden" name="moduleId" value={mod.id} />
                    <button type="submit" class="text-red-500 hover:text-red-700 text-xs" title="Eliminar Módulo">✕</button>
                  </form>
                </div>
                <h4 class="font-bold text-sm leading-tight group-hover:text-[var(--color-primary)] transition-colors line-clamp-2">
                  <a href={`/admin/escuela/${course.id}/modulos/${mod.id}/editar`} class="after:absolute after:inset-0 relative">{mod.title}</a>
                </h4>
              </li>
            ))}
          </ul>
        )}
      </div>

    </div>
  </div>
</AppLayout>
