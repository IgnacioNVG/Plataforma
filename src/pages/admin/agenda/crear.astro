---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { organizationTable, eventTable } from '../../../db/schema';
import crypto from 'node:crypto';

// Requerir autenticación básica (luego se puede restringir con authz)
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/validacion');
}

// Leer fecha pre-seleccionada de la URL
const urlParams = new URL(Astro.request.url).searchParams;
const defaultDate = urlParams.get('date') || '';

// Cargar lista de comisiones/organizaciones para proponer el evento
const organizations = await db.select().from(organizationTable).all();

let error = '';
let success = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const title = data.get('title') as string;
    const description = data.get('description') as string;
    const location = data.get('location') as string;
    const date = data.get('date') as string;
    const time = data.get('time') as string;
    const organizationId = data.get('organizationId') as string;

    if (!title || !description || !date || !time || !organizationId) {
      error = 'Faltan campos obligatorios.';
    } else {
      const eventDate = new Date(`${date}T${time}:00`);
      
      await db.insert(eventTable).values({
        id: crypto.randomUUID(),
        title,
        description,
        location: location || null,
        startDate: eventDate,
        organizationId,
        classification: 'publico', // Default
        status: 'propuesto' // ESTADO: PROPUESTO
      });
      
      success = 'Propuesta enviada exitosamente. Un secretario de la comisión deberá aprobarla para que aparezca en el calendario.';
    }
  } catch (e: any) {
    error = e.message || 'Error al proponer el evento.';
  }
}
---

<AppLayout title="Proponer Evento Orgánico">
  <div class="max-w-2xl mx-auto mt-8">
    <div class="mb-10 border-b-4 border-[var(--color-foreground)] pb-6">
      <h1 class="text-4xl font-black text-[var(--color-foreground)] uppercase tracking-tighter leading-none">Proponer Evento</h1>
      <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-4">Las propuestas serán revisadas por los Secretarios de la comisión designada.</p>
    </div>

    {error && (
      <div class="bg-red-50 border-2 border-red-600 text-red-700 p-4 mb-8 font-bold text-sm uppercase tracking-widest shadow-[4px_4px_0px_0px_#dc2626]">
        {error}
      </div>
    )}

    {success ? (
      <div class="bg-green-50 border-2 border-green-600 text-green-700 p-8 text-center shadow-[8px_8px_0px_0px_#16a34a]">
        <h2 class="text-2xl font-black uppercase mb-4">¡Propuesta Enviada!</h2>
        <p class="font-bold mb-6">{success}</p>
        <a href="/agenda" class="inline-block bg-[var(--color-foreground)] text-white px-6 py-3 font-black text-sm uppercase tracking-widest hover:bg-[var(--color-primary)] transition-colors">Volver a la Agenda</a>
      </div>
    ) : (
      <form method="POST" class="space-y-6 bg-[var(--color-background)] border-4 border-[var(--color-foreground)] p-8 shadow-[8px_8px_0px_0px_var(--color-foreground)]">
        
        <div class="space-y-2">
          <label for="organizationId" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Comisión u Órgano Organizador *</label>
          <select id="organizationId" name="organizationId" required class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none cursor-pointer">
            <option value="">Selecciona una comisión...</option>
            {organizations.map(org => (
              <option value={org.id}>{org.name} ({org.type})</option>
            ))}
          </select>
        </div>

        <div class="space-y-2">
          <label for="title" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Título del Evento *</label>
          <input type="text" id="title" name="title" required class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none" placeholder="Ej: Reunión Ordinaria de Finanzas" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="date" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Fecha *</label>
            <input type="date" id="date" name="date" value={defaultDate} required class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none" />
          </div>
          <div class="space-y-2">
            <label for="time" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Hora *</label>
            <input type="time" id="time" name="time" required class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none" />
          </div>
        </div>

        <div class="space-y-2">
          <label for="location" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Ubicación o Enlace</label>
          <input type="text" id="location" name="location" class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none" placeholder="Ej: Sede Central / Zoom" />
        </div>

        <div class="space-y-2">
          <label for="description" class="block text-xs font-black uppercase tracking-widest text-[var(--color-foreground)]">Descripción / Orden del Día *</label>
          <textarea id="description" name="description" required rows="4" class="w-full border-2 border-[var(--color-foreground)] bg-white px-4 py-3 font-bold focus:outline-none focus:border-[var(--color-primary)] focus:ring-2 focus:ring-[var(--color-primary)] transition-all rounded-none" placeholder="Puntos a tratar en el evento..."></textarea>
        </div>

        <div class="pt-4 border-t-2 border-[var(--color-border)]">
          <button type="submit" class="w-full bg-[var(--color-primary)] text-white px-6 py-4 font-black text-sm uppercase tracking-widest border-2 border-[var(--color-foreground)] shadow-[4px_4px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all">
            Enviar Propuesta
          </button>
        </div>
      </form>
    )}
  </div>
</AppLayout>
