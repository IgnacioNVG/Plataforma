---
import { authorize } from '../../../lib/authz';
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { eventTable } from '../../../db/schema';
import { desc } from 'drizzle-orm';

const user = Astro.locals.user;

const canManage = await authorize(user?.id, 'manage', 'event');
if (!canManage) {
  return Astro.redirect('/');
}

const events = await db.select().from(eventTable).orderBy(desc(eventTable.startDate));
---

<AppLayout title="Gestor de Agenda">
  <div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-end mb-8 border-b-4 border-[var(--color-foreground)] pb-4">
      <div>
        <h1 class="text-4xl font-black uppercase tracking-tighter">Gestor de Agenda</h1>
        <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-1">Administración de eventos y plenos</p>
      </div>
      <a href="/admin/agenda/crear" class="bg-[var(--color-primary)] text-white px-6 py-2 font-black text-sm uppercase tracking-widest border-2 border-[var(--color-primary)] shadow-[4px_4px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all">
        + Nuevo Evento
      </a>
    </div>

    <div class="bg-white border-4 border-[var(--color-foreground)] shadow-[8px_8px_0px_0px_var(--color-primary)] overflow-hidden">
      <table class="w-full text-left">
        <thead class="bg-[var(--color-foreground)] text-white">
          <tr>
            <th class="p-4 text-xs font-black uppercase tracking-widest">Fecha</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest">Título</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest">Nivel</th>
            <th class="p-4 text-xs font-black uppercase tracking-widest text-right">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y-2 divide-[var(--color-border)]">
          {events.length === 0 ? (
            <tr>
              <td colspan="4" class="p-8 text-center text-[var(--color-muted-foreground)] font-bold uppercase tracking-widest">No hay eventos programados</td>
            </tr>
          ) : (
            events.map((event) => (
              <tr class="hover:bg-[var(--color-secondary)] transition-colors">
                <td class="p-4 font-bold">
                  {new Date(event.startDate).toLocaleDateString('es-CL', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                </td>
                <td class="p-4 font-black uppercase">{event.title}</td>
                <td class="p-4">
                  <span class="text-[10px] font-black bg-gray-200 text-gray-800 px-2 py-1 uppercase tracking-widest border border-gray-400">
                    Nivel {event.requiredClearance}
                  </span>
                </td>
                <td class="p-4 text-right">
                  <a href={`/admin/agenda/editar/${event.id}`} class="text-xs font-black text-[var(--color-primary)] hover:underline uppercase tracking-widest">Editar</a>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AppLayout>
