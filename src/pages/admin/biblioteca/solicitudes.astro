---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { accessRequestTable, documentTable, userTable } from '../../../db/schema';
import { eq, desc, and } from 'drizzle-orm';
import { authorize } from '../../../lib/authz';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/');
}

// 1. Validar permiso de gestión documental
const canManageDocs = await authorize(user.id, 'manage', 'document');
if (!canManageDocs) {
  return new Response('Acceso Denegado', { status: 403 });
}

// 2. Manejar POST (Aprobar o Rechazar)
if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const reqId = data.get('reqId')?.toString();
  const action = data.get('action')?.toString(); // 'approve' o 'reject'

  if (reqId && (action === 'approve' || action === 'reject')) {
    const status = action === 'approve' ? 'approved' : 'rejected';
    
    await db.update(accessRequestTable)
      .set({ 
        status,
        resolvedAt: new Date(),
        resolvedByUserId: user.id
      })
      .where(eq(accessRequestTable.id, reqId));
    
    // Aquí idealmente enviaríamos una notificación al requesterUserId de que su solicitud fue aprobada/rechazada
  }
}

// 3. Obtener solicitudes pendientes
// Si el usuario tiene permisos globales, las verá todas. Si no, debería filtrarse por su organización.
// Como el authorize() ya es complejo, para la beta listaremos todas las pendientes en las que el usuario tenga permiso de manage sobre ese doc en específico.
// Para simplificar (dado que el beta user tiene global), traemos todas y validamos una por una si es necesario, pero como es un panel de mesa, asumimos que si entró aquí, puede gestionar.

const rawRequests = await db.select({
  request: accessRequestTable,
  doc: documentTable,
  requester: userTable
})
.from(accessRequestTable)
.innerJoin(documentTable, eq(accessRequestTable.documentId, documentTable.id))
.innerJoin(userTable, eq(accessRequestTable.requesterUserId, userTable.id))
.where(eq(accessRequestTable.status, 'pending'))
.orderBy(desc(accessRequestTable.requestedAt));

// Filtrado de seguridad (Solo mostrar solicitudes de documentos que ESTE usuario puede gestionar)
const pendingRequests = [];
for (const row of rawRequests) {
  const canManageThisDoc = await authorize(user.id, 'manage', 'document', row.doc.classification as any, row.doc.organizationId, row.doc.id);
  if (canManageThisDoc) {
    pendingRequests.push(row);
  }
}
---

<AppLayout title="Buzón de Accesos | Biblioteca">
  <div class="max-w-5xl mx-auto py-12 px-4">
    
    <div class="flex items-center justify-between mb-12 border-b-4 border-[var(--color-foreground)] pb-6">
      <div>
        <h1 class="text-4xl font-black uppercase tracking-tighter text-[var(--color-foreground)]">Solicitudes de Acceso</h1>
        <p class="text-[var(--color-muted-foreground)] font-bold uppercase tracking-widest text-sm mt-2">Buzón de la Mesa Directiva</p>
      </div>
      <a href="/biblioteca" class="bg-[var(--color-secondary)] px-6 py-3 border-4 border-[var(--color-foreground)] text-[var(--color-foreground)] font-black uppercase tracking-widest hover:bg-[var(--color-foreground)] hover:text-white transition-colors">
        Volver
      </a>
    </div>

    {pendingRequests.length === 0 ? (
      <div class="border-4 border-dashed border-[var(--color-muted-foreground)] p-12 text-center bg-[var(--color-secondary)]">
        <p class="text-xl font-black uppercase tracking-widest text-[var(--color-muted-foreground)]">No hay solicitudes pendientes</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-6">
        {pendingRequests.map(({ request, doc, requester }) => (
          <div class="border-4 border-[var(--color-foreground)] bg-[var(--color-background)] p-6 flex flex-col md:flex-row gap-6 items-start md:items-center justify-between shadow-[6px_6px_0px_0px_var(--color-primary)]">
            
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-2">
                <span class="bg-[var(--color-secondary)] text-[var(--color-foreground)] px-3 py-1 text-xs font-black uppercase tracking-widest border border-[var(--color-foreground)]">
                  Petición de Acceso
                </span>
                <span class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase">
                  Hace {Math.floor((new Date().getTime() - new Date(request.requestedAt).getTime()) / 60000)} min
                </span>
              </div>
              <h3 class="text-xl font-black uppercase tracking-tight">{doc.title}</h3>
              <p class="text-sm font-bold text-[var(--color-muted-foreground)] mt-1">
                Solicitado por: <span class="text-[var(--color-foreground)]">{requester.name} {requester.lastName}</span>
              </p>
            </div>

            <div class="flex gap-4 w-full md:w-auto">
              <form method="POST" class="flex-1 md:flex-none">
                <input type="hidden" name="reqId" value={request.id} />
                <input type="hidden" name="action" value="reject" />
                <button type="submit" class="w-full bg-red-600 text-white px-6 py-3 font-black uppercase tracking-widest border-2 border-[var(--color-foreground)] hover:bg-red-700 transition-colors shadow-[4px_4px_0px_0px_var(--color-foreground)] active:translate-y-1 active:translate-x-1 active:shadow-none">
                  Rechazar
                </button>
              </form>
              <form method="POST" class="flex-1 md:flex-none">
                <input type="hidden" name="reqId" value={request.id} />
                <input type="hidden" name="action" value="approve" />
                <button type="submit" class="w-full bg-green-600 text-white px-6 py-3 font-black uppercase tracking-widest border-2 border-[var(--color-foreground)] hover:bg-green-700 transition-colors shadow-[4px_4px_0px_0px_var(--color-foreground)] active:translate-y-1 active:translate-x-1 active:shadow-none">
                  Aprobar
                </button>
              </form>
            </div>

          </div>
        ))}
      </div>
    )}

  </div>
</AppLayout>
