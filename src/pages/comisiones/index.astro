---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Comisiones de Trabajo">
  <div class="mb-8 flex justify-between items-end border-b border-[var(--color-foreground)] pb-6">
    <div>
      <h1 class="text-4xl font-bold text-[var(--color-foreground)]">Comisiones</h1>
      <p class="text-[var(--color-muted-foreground)] mt-2">Grupos de trabajo programático, frentes de masas y espacios orgánicos.</p>
    </div>
    <button class="bg-[var(--color-foreground)] text-white px-4 py-2 font-bold text-sm hover:bg-[var(--color-primary)] transition-colors rounded-[var(--radius-sm)] hidden md:block">
      Solicitar Nueva Comisión
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    
    <!-- Comisiones Activas -->
    <div class="space-y-6">
      <h2 class="text-xl font-bold text-[var(--color-foreground)] border-b border-[var(--color-border)] pb-2">Tus Comisiones</h2>
      
      <!-- Card Comisión -->
      <article class="border border-[var(--color-foreground)] bg-[var(--color-foreground)] text-white p-6 rounded-[var(--radius-sm)] flex flex-col gap-4 relative overflow-hidden">
        <svg class="absolute -right-10 -bottom-10 w-48 h-48 opacity-10 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 22h20L12 2z"></path></svg>
        <div class="relative z-10">
          <div class="flex justify-between items-start mb-2">
            <span class="bg-[var(--color-primary)] text-white text-[10px] font-bold px-2 py-0.5 uppercase tracking-widest">Nivel Nacional</span>
            <span class="text-xs font-medium text-gray-300">Miembro Activo</span>
          </div>
          <h3 class="text-2xl font-bold mb-2">Comisión Política</h3>
          <p class="text-sm text-gray-300 mb-6">Instancia de deliberación estratégica y definición de la línea política a corto y mediano plazo.</p>
          
          <div class="flex gap-3">
            <button class="bg-white text-[var(--color-foreground)] px-4 py-1.5 text-sm font-bold rounded-[var(--radius-sm)] hover:bg-gray-200 transition-colors">
              Ir al Tablero
            </button>
          </div>
        </div>
      </article>

    </div>

    <!-- Directorio de Comisiones -->
    <div class="space-y-6">
      <h2 class="text-xl font-bold text-[var(--color-foreground)] border-b border-[var(--color-border)] pb-2">Explorar Espacios</h2>
      
      <div class="flex flex-col gap-4">
        <!-- Item -->
        <div class="border border-[var(--color-border)] bg-[var(--color-background)] p-4 rounded-[var(--radius-sm)] flex justify-between items-center hover:border-[var(--color-foreground)] transition-colors">
          <div>
            <h4 class="font-bold text-[var(--color-foreground)]">Frente Estudiantil</h4>
            <p class="text-xs text-[var(--color-muted-foreground)] mt-1">42 miembros • Última actividad hoy</p>
          </div>
          <button class="text-xs font-bold border border-[var(--color-border)] px-3 py-1 hover:bg-[var(--color-secondary)] transition-colors">
            Unirse
          </button>
        </div>
        
        <!-- Item -->
        <div class="border border-[var(--color-border)] bg-[var(--color-background)] p-4 rounded-[var(--radius-sm)] flex justify-between items-center hover:border-[var(--color-foreground)] transition-colors">
          <div>
            <h4 class="font-bold text-[var(--color-foreground)]">Comisión de Medio Ambiente</h4>
            <p class="text-xs text-[var(--color-muted-foreground)] mt-1">15 miembros • Última actividad hace 2 días</p>
          </div>
          <button class="text-xs font-bold border border-[var(--color-border)] px-3 py-1 hover:bg-[var(--color-secondary)] transition-colors">
            Unirse
          </button>
        </div>
      </div>

    </div>

  </div>
</AppLayout>
