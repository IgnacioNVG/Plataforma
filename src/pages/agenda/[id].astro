---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { eventTable, organizationTable, documentTable } from '../../db/schema';
import { eq } from 'drizzle-orm';

const { id } = Astro.params;
if (!id) return Astro.redirect('/agenda');

const record = await db.select({
  event: eventTable,
  org: organizationTable,
  doc: documentTable
})
.from(eventTable)
.leftJoin(organizationTable, eq(eventTable.organizationId, organizationTable.id))
.leftJoin(documentTable, eq(eventTable.documentId, documentTable.id))
.where(eq(eventTable.id, id))
.get();

if (!record) return Astro.redirect('/agenda');

const { event, org, doc } = record;

// Extraer ID de YouTube si existe
let youtubeId = null;
if (event.youtubeUrl) {
  const ytRegex = /(?:https?:\/\/)?(?:www\.)?(?:youtube\.com\/(?:[^\/\n\s]+\/\S+\/|(?:v|e(?:mbed)?)\/|\S*?[?&]v=)|youtu\.be\/)([a-zA-Z0-9_-]{11})(?:\S+)?/g;
  const match = ytRegex.exec(event.youtubeUrl);
  if (match && match[1]) {
    youtubeId = match[1];
  }
}
---

<AppLayout title={`${event.title} | Agenda`}>
  <div class="max-w-4xl mx-auto mt-8">
    
    <div class="mb-6 flex gap-2 text-xs font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]">
      <a href="/agenda" class="hover:text-[var(--color-foreground)] transition-colors">Agenda</a>
      <span>/</span>
      <span class="text-[var(--color-foreground)]">Detalle del Evento</span>
    </div>

    {youtubeId && (
      <div class="w-full aspect-video border-4 border-[var(--color-foreground)] shadow-[8px_8px_0px_0px_var(--color-primary)] mb-10 bg-black">
        <iframe 
          src={`https://www.youtube.com/embed/${youtubeId}`} 
          class="w-full h-full border-none" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen>
        </iframe>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Panel de Contenido -->
      <div class="md:col-span-2 space-y-8">
        <div>
          <h1 class="text-4xl font-black text-[var(--color-foreground)] uppercase tracking-tighter leading-tight mb-2">{event.title}</h1>
          {org && (
            <div class="inline-block bg-[var(--color-secondary)] border-2 border-[var(--color-foreground)] px-3 py-1 text-xs font-black uppercase tracking-widest">
              {org.name}
            </div>
          )}
        </div>

        <div class="border-t-4 border-[var(--color-foreground)] pt-6 prose prose-sm max-w-none text-[var(--color-foreground)] font-medium leading-relaxed whitespace-pre-wrap">
          {event.description}
        </div>
        
        {!youtubeId && event.youtubeUrl && (
           <div class="bg-gray-100 p-4 border-2 border-gray-300 flex flex-col gap-2">
             <span class="text-xs font-bold uppercase tracking-widest">Enlace Externo</span>
             <a href={event.youtubeUrl} target="_blank" class="text-blue-600 hover:underline break-all">{event.youtubeUrl}</a>
           </div>
        )}
      </div>

      <!-- Panel Lateral (Metadatos y Adjuntos) -->
      <div class="md:col-span-1 space-y-6">
        
        <div class="border-4 border-[var(--color-foreground)] bg-white shadow-[6px_6px_0px_0px_var(--color-foreground)] p-6">
          <h3 class="text-lg font-black uppercase tracking-tight border-b-2 border-[var(--color-border)] pb-2 mb-4">Información</h3>
          <dl class="space-y-4">
            <div>
              <dt class="text-[10px] font-black uppercase tracking-widest text-[var(--color-muted-foreground)]">Fecha y Hora</dt>
              <dd class="font-bold text-sm mt-1">{new Date(event.startDate).toLocaleString('es-CL', { weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })} hrs</dd>
            </div>
            <div>
              <dt class="text-[10px] font-black uppercase tracking-widest text-[var(--color-muted-foreground)]">Ubicación</dt>
              <dd class="font-bold text-sm mt-1">{event.location || 'Por definir'}</dd>
            </div>
            <div>
              <dt class="text-[10px] font-black uppercase tracking-widest text-[var(--color-muted-foreground)]">Estado</dt>
              <dd class="font-bold text-sm mt-1 uppercase text-[var(--color-primary)]">{event.status}</dd>
            </div>
          </dl>
        </div>

        {doc && (
          <div class="border-4 border-[var(--color-primary)] bg-[var(--color-secondary)] shadow-[6px_6px_0px_0px_var(--color-primary)] p-6 text-center">
            <h3 class="text-lg font-black uppercase tracking-tight mb-2 text-[var(--color-foreground)]">Acta Oficial</h3>
            <p class="text-xs font-bold text-[var(--color-muted-foreground)] mb-6">Documento asociado a este evento</p>
            <div class="w-16 h-16 mx-auto border-2 border-[var(--color-foreground)] bg-white flex items-center justify-center text-3xl mb-4">
              📄
            </div>
            <a href={`/biblioteca/${doc.id}`} class="block w-full bg-[var(--color-foreground)] text-white font-black uppercase tracking-widest py-3 border-2 border-[var(--color-foreground)] hover:bg-[var(--color-primary)] transition-colors shadow-[2px_2px_0px_0px_var(--color-foreground)] active:translate-y-1 active:translate-x-1 active:shadow-none">
              Ver Documento
            </a>
          </div>
        )}

      </div>
    </div>
  </div>
</AppLayout>
