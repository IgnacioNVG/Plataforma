---
import { authorize } from '../../lib/authz';
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { eventTable, organizationTable, appointmentTable, positionTypeTable } from '../../db/schema';
import { gte, lte, and, eq, inArray, or, isNull } from 'drizzle-orm';

// Navegación de Vista y Fecha
const urlParams = new URL(Astro.request.url).searchParams;
const viewType = urlParams.get('vista') || 'mes'; // 'mes' o 'semana'
const dateParam = urlParams.get('fecha');

let currentDate = new Date();
if (dateParam) {
  const parsed = new Date(dateParam + "T00:00:00");
  if (!isNaN(parsed.getTime())) currentDate = parsed;
}

// Para asegurar que trabajamos con el inicio del día local
currentDate.setHours(0, 0, 0, 0);

const currentYear = currentDate.getFullYear();
const currentMonth = currentDate.getMonth();

let daysInGrid = [];
let startDateForGrid = new Date();
let prevBtnDate = new Date();
let nextBtnDate = new Date();
let displayTitle = '';

if (viewType === 'mes') {
  const firstDayOfMonth = new Date(currentYear, currentMonth, 1);
  let startDayOfWeek = firstDayOfMonth.getDay() - 1;
  if (startDayOfWeek === -1) startDayOfWeek = 6; // Domingo

  startDateForGrid = new Date(firstDayOfMonth);
  startDateForGrid.setDate(startDateForGrid.getDate() - startDayOfWeek); // Retrocede al Lunes anterior

  for (let i = 0; i < 42; i++) { // 6 semanas
    daysInGrid.push(new Date(startDateForGrid));
    startDateForGrid.setDate(startDateForGrid.getDate() + 1);
  }

  prevBtnDate = new Date(currentYear, currentMonth - 1, 1);
  nextBtnDate = new Date(currentYear, currentMonth + 1, 1);
  displayTitle = new Intl.DateTimeFormat('es-CL', { month: 'long', year: 'numeric' }).format(currentDate);
} else {
  // Vista Semanal
  let dayOfWeek = currentDate.getDay() - 1;
  if (dayOfWeek === -1) dayOfWeek = 6;
  
  startDateForGrid = new Date(currentDate);
  startDateForGrid.setDate(startDateForGrid.getDate() - dayOfWeek); // Lunes de esta semana

  for (let i = 0; i < 7; i++) { // 1 semana
    daysInGrid.push(new Date(startDateForGrid));
    startDateForGrid.setDate(startDateForGrid.getDate() + 1);
  }

  prevBtnDate = new Date(currentDate);
  prevBtnDate.setDate(prevBtnDate.getDate() - 7);
  nextBtnDate = new Date(currentDate);
  nextBtnDate.setDate(nextBtnDate.getDate() + 7);
  
  // Título: "15 - 21 de Julio, 2026"
  const firstDay = daysInGrid[0];
  const lastDay = daysInGrid[6];
  displayTitle = `${firstDay.getDate()} al ${lastDay.getDate()} de ${new Intl.DateTimeFormat('es-CL', { month: 'long', year: 'numeric' }).format(lastDay)}`;
}

const formatDateStr = (d) => {
  const yyyy = d.getFullYear();
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${yyyy}-${mm}-${dd}`;
};

const prevBtnStr = formatDateStr(prevBtnDate);
const nextBtnStr = formatDateStr(nextBtnDate);
const todayStr = formatDateStr(new Date());

const gridStart = daysInGrid[0];
const gridEnd = daysInGrid[daysInGrid.length - 1];

const user = Astro.locals.user;
if (!user) return Astro.redirect('/');

// Obtener los espacios del usuario
const myAppointments = await db.select({
  org: organizationTable
}).from(appointmentTable)
  .innerJoin(organizationTable, eq(appointmentTable.organizationId, organizationTable.id))
  .where(and(eq(appointmentTable.userId, user.id), eq(appointmentTable.status, 'activo')))
  .all();

const myOrgIds = myAppointments.map(a => a.org.id);

// Condición para traer eventos (Globales o de los espacios del usuario)
const orgCondition = myOrgIds.length > 0 
  ? or(isNull(eventTable.organizationId), inArray(eventTable.organizationId, myOrgIds))
  : isNull(eventTable.organizationId);

// Traer Eventos del mes
const eventsInGrid = await db.select({
    event: eventTable,
    org: organizationTable
  })
  .from(eventTable)
  .leftJoin(organizationTable, eq(eventTable.organizationId, organizationTable.id))
  .where(
    and(
      gte(eventTable.startDate, gridStart),
      lte(eventTable.startDate, gridEnd),
      eq(eventTable.status, 'aprobado'),
      orgCondition
    )
  );

// Traer Próximos Eventos (7 días) para el sidebar
const today = new Date();
today.setHours(0,0,0,0);
const nextWeek = new Date(today);
nextWeek.setDate(nextWeek.getDate() + 7);

const upcomingEvents = await db.select({
    event: eventTable,
    org: organizationTable
  })
  .from(eventTable)
  .leftJoin(organizationTable, eq(eventTable.organizationId, organizationTable.id))
  .where(
    and(
      gte(eventTable.startDate, today),
      lte(eventTable.startDate, nextWeek),
      eq(eventTable.status, 'aprobado'),
      orgCondition
    )
  )
  .orderBy(eventTable.startDate);


const canEdit = await authorize(user?.id, 'manage', 'event');
---

<AppLayout title="Agenda Institucional">
  <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between border-b-4 border-[var(--color-foreground)] pb-6 gap-4">
    <div>
      <h1 class="text-5xl font-black text-[var(--color-foreground)] uppercase tracking-tighter">Agenda Orgánica</h1>
      <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-2 border-l-4 border-[var(--color-primary)] pl-3">Planificación y eventos territoriales</p>
    </div>
    <div class="flex flex-col md:flex-row gap-4 items-center">
      <!-- Selector de Vista -->
      <div class="flex border-2 border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-foreground)]">
        <a href={`/agenda?vista=mes&fecha=${formatDateStr(currentDate)}`} class={`px-4 py-2 font-black text-xs uppercase tracking-widest transition-colors ${viewType === 'mes' ? 'bg-[var(--color-foreground)] text-white' : 'bg-white text-[var(--color-foreground)] hover:bg-gray-100'}`}>
          Mes
        </a>
        <a href={`/agenda?vista=semana&fecha=${formatDateStr(currentDate)}`} class={`px-4 py-2 font-black text-xs uppercase tracking-widest transition-colors border-l-2 border-[var(--color-foreground)] ${viewType === 'semana' ? 'bg-[var(--color-foreground)] text-white' : 'bg-white text-[var(--color-foreground)] hover:bg-gray-100'}`}>
          Semana
        </a>
      </div>

      <div class="hidden md:flex gap-2">
        <a href={`/agenda?vista=${viewType}&fecha=${prevBtnStr}`} class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] px-4 py-2 font-black text-sm uppercase tracking-widest hover:bg-[var(--color-foreground)] hover:text-white transition-colors block text-center">
          &larr; Ant
        </a>
        <div class="bg-[var(--color-foreground)] text-white px-6 py-2 font-black text-sm uppercase tracking-widest cursor-default flex items-center justify-center min-w-[200px]">
          {displayTitle}
        </div>
        <a href={`/agenda?vista=${viewType}&fecha=${nextBtnStr}`} class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] px-4 py-2 font-black text-sm uppercase tracking-widest hover:bg-[var(--color-foreground)] hover:text-white transition-colors block text-center">
          Sig &rarr;
        </a>
      </div>
      {canEdit && (
        <div class="flex gap-2">
          <a href="/admin/agenda" class="bg-[var(--color-primary)] text-white px-6 py-2 font-black text-sm uppercase tracking-widest border-2 border-[var(--color-primary)] shadow-[4px_4px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all flex items-center justify-center">
            ⚙️ Gestor de Agenda
          </a>
        </div>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <!-- Sidebar -->
    <aside class="lg:col-span-1 space-y-8">
      <!-- Filtros -->
      <div class="space-y-4">
        <h3 class="text-xs font-black text-[var(--color-foreground)] uppercase tracking-widest border-b-2 border-[var(--color-border)] pb-2">Espacios Visibles</h3>
        <div class="flex flex-col gap-2" id="org-filters">
          <label class="flex items-center gap-3 cursor-pointer group p-2 border-2 border-[var(--color-foreground)] bg-[#FFFDF5] hover:bg-gray-100 transition-colors">
            <input type="checkbox" value="global" class="org-checkbox w-5 h-5 rounded-none border-2 border-[var(--color-foreground)] text-[var(--color-primary)] focus:ring-0 checked:bg-[var(--color-primary)]" checked />
            <span class="text-xs font-black uppercase tracking-widest">Global / Nacional</span>
          </label>
          
          {myAppointments.map(appt => (
            <label class="flex items-center gap-3 cursor-pointer group p-2 border-2 border-[var(--color-foreground)] bg-white hover:bg-gray-100 transition-colors">
              <input type="checkbox" value={appt.org.id} class="org-checkbox w-5 h-5 rounded-none border-2 border-[var(--color-foreground)] text-[var(--color-foreground)] focus:ring-0 checked:bg-[var(--color-foreground)]" checked />
              <span class="text-xs font-black uppercase tracking-widest truncate" title={appt.org.name}>{appt.org.name}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Próximos Eventos Timeline -->
      <div>
        <h3 class="text-xs font-black text-[var(--color-foreground)] uppercase tracking-widest border-b-2 border-[var(--color-foreground)] pb-2 mb-6">Próximos en 7 días</h3>
        
        <div class="relative pl-4 border-l-2 border-[var(--color-border)] space-y-8 ml-2">
          {upcomingEvents.length === 0 ? (
            <p class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest">Sin eventos próximos.</p>
          ) : (
            upcomingEvents.map(({ event, org }) => (
              <a href={`/agenda/${event.id}`} class="event-item relative block group" data-org-id={event.organizationId || 'global'}>
                <div class={`absolute -left-[23px] top-0 w-3 h-3 rounded-none ring-4 ring-[var(--color-background)] border-2 border-[var(--color-foreground)] ${event.classification === 'publico' ? 'bg-[var(--color-primary)]' : 'bg-[var(--color-foreground)]'} transition-colors group-hover:bg-yellow-400`}></div>
                <div class={`text-[10px] font-black uppercase tracking-widest mb-1 ${event.classification === 'publico' ? 'text-[var(--color-primary)]' : 'text-[var(--color-foreground)]'}`}>
                  {new Date(event.startDate).toLocaleDateString('es-CL', { weekday: 'long', day: 'numeric' })} • {new Date(event.startDate).toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' })} hrs
                </div>
                <h4 class="font-black text-sm uppercase leading-tight group-hover:underline">{event.title}</h4>
                {org && <p class="text-[10px] font-black uppercase tracking-widest text-[var(--color-primary)] mt-1 truncate">{org.name}</p>}
                {!org && <p class="text-[10px] font-black uppercase tracking-widest text-gray-500 mt-1 truncate">Nacional</p>}
                {event.location && <p class="text-xs font-medium text-[var(--color-muted-foreground)] mt-1">{event.location}</p>}
              </a>
            ))
          )}
        </div>
      </div>
    </aside>

    <!-- Calendario Brutalista -->
    <div class="lg:col-span-3">
      <div class="w-full bg-[var(--color-background)] border-4 border-[var(--color-foreground)]">
        
        <!-- Días de la semana -->
        <div class="grid grid-cols-7 border-b-4 border-[var(--color-foreground)] bg-[var(--color-secondary)]">
          {['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'].map(day => (
            <div class="py-3 text-center text-xs font-black uppercase tracking-widest border-r-2 border-[var(--color-foreground)] last:border-r-0 text-[var(--color-foreground)]">
              {day}
            </div>
          ))}
        </div>

        <!-- Grilla de días -->
        <div class="grid grid-cols-7 auto-rows-fr">
          {daysInGrid.map((date, idx) => {
            const isCurrentMonth = date.getMonth() === currentMonth;
            const isToday = date.toDateString() === new Date().toDateString();
            
            // Buscar eventos para este día
            const dayEvents = eventsInGrid.filter(e => new Date(e.event.startDate).toDateString() === date.toDateString());
            const dateString = formatDateStr(date);

            // Determinar clases de estilo basadas en el estado del día
            let cellClasses = "min-h-[140px] p-2 border-b-2 border-[var(--color-foreground)] relative transition-colors group ";
            
            if (!isCurrentMonth && viewType === 'mes') {
              cellClasses += "bg-gray-100 stripe-pattern text-gray-400 ";
            } else if (isToday) {
              cellClasses += "bg-[#FFF9F9] border-t-[6px] border-t-[var(--color-primary)] ";
            } else {
              cellClasses += "hover:bg-[var(--color-secondary)] ";
            }

            // Borde derecho para todos excepto el último de la fila
            if ((idx + 1) % 7 !== 0) {
              cellClasses += "border-r-2 ";
            }

            return (
              <div class={cellClasses}>
                <a href={`/admin/agenda?date=${dateString}`} class="absolute inset-0 z-0" aria-label={`Crear evento el ${dateString}`} title="Haz clic para proponer un evento en este día"></a>
                
                <span class={`relative z-10 text-sm font-black pointer-events-none ${isToday ? 'text-white bg-[var(--color-primary)] px-2 py-0.5 rounded-none shadow-[2px_2px_0px_0px_var(--color-foreground)] border border-[var(--color-foreground)]' : (isCurrentMonth || viewType === 'semana' ? 'text-[var(--color-foreground)]' : 'bg-white px-1')}`}>
                  {date.getDate()}
                </span>
                
                <div class="mt-2 flex flex-col gap-1 relative z-10">
                  {dayEvents.map(({ event, org }) => {
                    const colorClass = event.classification === 'publico'
                      ? 'bg-[var(--color-primary)] text-white border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-foreground)] hover:shadow-[1px_1px_0px_0px_var(--color-foreground)]' 
                      : 'bg-white text-[var(--color-foreground)] border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-foreground)] hover:shadow-[1px_1px_0px_0px_var(--color-foreground)]';

                    return (
                      <a href={`/agenda/${event.id}`} class={`event-item block border-2 text-[9px] p-1 font-black uppercase tracking-widest leading-none hover:translate-y-px hover:translate-x-px transition-all flex flex-col gap-0.5 relative z-20 ${colorClass}`} title={event.title} data-org-id={event.organizationId || 'global'}>
                        <span class="truncate">{new Date(event.startDate).toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' })} - {event.title}</span>
                        {org && <span class="opacity-80 text-[7px] truncate">{org.name}</span>}
                        {!org && <span class="opacity-80 text-[7px] truncate text-gray-500">Nacional</span>}
                      </a>
                    );
                  })}
                  
                  <div class="hidden group-hover:flex items-center justify-center border-2 border-dashed border-[var(--color-muted-foreground)] text-[var(--color-muted-foreground)] p-1 text-[8px] font-black uppercase tracking-widest opacity-50 mt-1">
                    + Agendar
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <style>
    .stripe-pattern {
      background-image: repeating-linear-gradient(
        45deg,
        #f3f4f6,
        #f3f4f6 10px,
        #ffffff 10px,
        #ffffff 20px
      );
    }
  </style>

  <script>
    // Filtrado de eventos en el cliente
    const checkboxes = document.querySelectorAll('.org-checkbox');
    const events = document.querySelectorAll('.event-item');

    function filterEvents() {
      const checkedValues = Array.from(checkboxes)
        .filter(cb => (cb as HTMLInputElement).checked)
        .map(cb => (cb as HTMLInputElement).value);

      events.forEach(el => {
        const orgId = el.getAttribute('data-org-id');
        if (checkedValues.includes(orgId)) {
          (el as HTMLElement).style.display = 'block';
        } else {
          (el as HTMLElement).style.display = 'none';
        }
      });
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', filterEvents);
    });

    // Run on load
    filterEvents();
  </script>
</AppLayout>
