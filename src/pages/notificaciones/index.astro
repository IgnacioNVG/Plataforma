---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Notificaciones">
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-8 flex justify-between items-end border-b-4 border-[var(--color-foreground)] pb-4">
      <div>
        <h1 class="text-4xl font-black text-[var(--color-foreground)] uppercase tracking-tight">Centro de<br/>Alertas</h1>
      </div>
      <div class="text-right">
        <button class="text-xs font-bold uppercase tracking-widest text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)] transition-colors">
          Marcar todo como leído
        </button>
      </div>
    </div>

    <!-- Lista de Notificaciones -->
    <div class="space-y-4">
      
      <!-- Notificación No Leída -->
      <div class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] p-4 shadow-[4px_4px_0px_0px_var(--color-foreground)] flex gap-4 transition-all">
        <div class="w-2 h-2 bg-[var(--color-primary)] rounded-full mt-2 flex-shrink-0"></div>
        <div class="flex-1">
          <div class="flex justify-between items-start mb-1">
            <span class="text-[10px] font-bold text-[var(--color-primary)] uppercase tracking-widest">Módulo: Foros</span>
            <span class="text-[10px] font-bold text-[var(--color-muted-foreground)] uppercase">Hace 10 min</span>
          </div>
          <p class="text-sm font-medium text-[var(--color-foreground)] leading-relaxed">
            <strong class="font-bold">@crojas</strong> te ha mencionado en el hilo <a href="/foros/1" class="underline hover:text-[var(--color-primary)]">"Reevaluando el concepto de Estado de Bienestar"</a>.
          </p>
        </div>
      </div>

      <!-- Notificación No Leída -->
      <div class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] p-4 shadow-[4px_4px_0px_0px_var(--color-foreground)] flex gap-4 transition-all">
        <div class="w-2 h-2 bg-[var(--color-primary)] rounded-full mt-2 flex-shrink-0"></div>
        <div class="flex-1">
          <div class="flex justify-between items-start mb-1">
            <span class="text-[10px] font-bold text-[var(--color-foreground)] uppercase tracking-widest">Resolución Orgánica</span>
            <span class="text-[10px] font-bold text-[var(--color-muted-foreground)] uppercase">Hace 2 horas</span>
          </div>
          <p class="text-sm font-medium text-[var(--color-foreground)] leading-relaxed">
            Se ha subido un nuevo documento clasificado como <strong class="bg-[var(--color-foreground)] text-white px-1">INTERNO</strong> en tu territorio: <a href="/biblioteca/1" class="underline hover:text-[var(--color-primary)]">Acta Resolutiva RM Centro.pdf</a>.
          </p>
        </div>
      </div>

      <!-- Notificación Leída (Grisácea) -->
      <div class="bg-[var(--color-secondary)] border border-[var(--color-border)] p-4 flex gap-4 opacity-70 hover:opacity-100 transition-opacity">
        <div class="w-2 h-2 bg-transparent rounded-full mt-2 flex-shrink-0"></div>
        <div class="flex-1">
          <div class="flex justify-between items-start mb-1">
            <span class="text-[10px] font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest">Escuela de Formación</span>
            <span class="text-[10px] font-bold text-[var(--color-muted-foreground)] uppercase">Ayer</span>
          </div>
          <p class="text-sm font-medium text-[var(--color-muted-foreground)] leading-relaxed">
            Has completado exitosamente el curso "Historia del Movimiento Obrero". Se ha añadido la insignia a tu perfil.
          </p>
        </div>
      </div>
      
    </div>
  </div>
</AppLayout>
