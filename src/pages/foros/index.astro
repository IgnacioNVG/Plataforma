---
import { authorize } from '../../lib/authz';
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { forumCategoryTable, forumTopicTable } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
const canEdit = await authorize(user?.id, 'manage', 'forum');

const categories = await db.select().from(forumCategoryTable);
const topics = await db.select().from(forumTopicTable).orderBy(desc(forumTopicTable.createdAt));

const categoriesWithStats = categories.map(cat => {
  const catTopics = topics.filter(t => t.categoryId === cat.id);
  const latestTopic = catTopics.length > 0 ? catTopics[0] : null;
  return {
    ...cat,
    topicCount: catTopics.length,
    latestTopic
  };
});
---

<AppLayout title="Foros de Debate">
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between border-b-4 border-[var(--color-foreground)] pb-6 gap-4">
      <div>
        <h1 class="text-5xl font-black text-[var(--color-foreground)] uppercase tracking-tighter">Debate Interno</h1>
        <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-2 border-l-4 border-[var(--color-primary)] pl-3">Foros orgánicos y discusión política</p>
      </div>
      <div>
        {canEdit && (
          <a href="/admin/foros" class="bg-[var(--color-secondary)] text-[var(--color-foreground)] px-4 py-2 font-black text-xs uppercase tracking-widest border-2 border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all flex items-center justify-center">
            ⚙️ Gestor de Categorías
          </a>
        )}
      </div>
    </div>

    <div class="bg-white border-4 border-[var(--color-foreground)] shadow-[8px_8px_0px_0px_var(--color-primary)]">
      <div class="hidden md:grid grid-cols-12 gap-4 border-b-4 border-[var(--color-foreground)] bg-[var(--color-foreground)] text-white p-4">
        <div class="col-span-6 font-black text-xs uppercase tracking-widest">Categoría</div>
        <div class="col-span-2 font-black text-xs uppercase tracking-widest text-center">Temas</div>
        <div class="col-span-4 font-black text-xs uppercase tracking-widest">Última Actividad</div>
      </div>

      <div class="divide-y-2 divide-[var(--color-border)]">
        {categoriesWithStats.length === 0 ? (
          <div class="p-8 text-center text-[var(--color-muted-foreground)] font-bold uppercase tracking-widest">No hay foros abiertos aún</div>
        ) : (
          categoriesWithStats.map(cat => (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 hover:bg-[var(--color-secondary)] transition-colors group">
              <div class="col-span-1 md:col-span-6">
                <a href={`/foros/${cat.id}`} class="text-xl font-black uppercase tracking-tight text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors block w-full">
                  {cat.name}
                </a>
                <p class="text-sm font-medium text-[var(--color-muted-foreground)] mt-1">{cat.description}</p>
              </div>
              
              <div class="col-span-1 md:col-span-2 flex md:justify-center items-center">
                <span class="bg-[var(--color-background)] border-2 border-[var(--color-foreground)] px-3 py-1 text-xs font-black">
                  {cat.topicCount} Temas
                </span>
              </div>
              
              <div class="col-span-1 md:col-span-4 flex flex-col justify-center">
                {cat.latestTopic ? (
                  <>
                    <a href={`/foros/tema/${cat.latestTopic.id}`} class="text-sm font-bold truncate hover:underline text-[var(--color-foreground)]">
                      {cat.latestTopic.title}
                    </a>
                    <span class="text-xs font-bold text-[var(--color-muted-foreground)] mt-1 uppercase tracking-widest">
                      Última public. hace {Math.floor((new Date().getTime() - new Date(cat.latestTopic.createdAt).getTime()) / (1000 * 3600 * 24))} días
                    </span>
                  </>
                ) : (
                  <span class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest italic">
                    Sin actividad
                  </span>
                )}
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </div>
</AppLayout>
