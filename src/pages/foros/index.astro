---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Foros de Debate">
  <div class="max-w-4xl mx-auto">
    <!-- Header Foros -->
    <div class="mb-8 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-[var(--color-foreground)]">Foros de Debate</h1>
        <p class="text-[var(--color-muted-foreground)] mt-1">Espacio de discusión política y programática</p>
      </div>
      <button class="bg-[var(--color-foreground)] text-white px-4 py-2 font-bold text-sm hover:bg-[var(--color-primary)] transition-colors rounded-[var(--radius-sm)]">
        + Nuevo Tema
      </button>
    </div>

    <!-- Filtros tipo Reddit -->
    <div class="flex items-center gap-4 bg-[var(--color-secondary)] p-2 rounded-[var(--radius-sm)] mb-6 border border-[var(--color-border)]">
      <button class="flex items-center gap-2 bg-[var(--color-background)] text-[var(--color-foreground)] px-3 py-1.5 rounded-[var(--radius-sm)] font-bold text-sm shadow-sm border border-[var(--color-border)]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path></svg>
        Populares
      </button>
      <button class="flex items-center gap-2 text-[var(--color-muted-foreground)] hover:bg-[var(--color-border)] px-3 py-1.5 rounded-[var(--radius-sm)] font-medium text-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Recientes
      </button>
      <button class="flex items-center gap-2 text-[var(--color-muted-foreground)] hover:bg-[var(--color-border)] px-3 py-1.5 rounded-[var(--radius-sm)] font-medium text-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
        Con más respuestas
      </button>
    </div>

    <!-- Lista de Hilos -->
    <div class="flex flex-col gap-4">
      
      <!-- Hilo (Post) -->
      <article class="bg-[var(--color-background)] border border-[var(--color-border)] rounded-[var(--radius-sm)] p-4 flex gap-4 hover:border-[var(--color-foreground)] transition-colors">
        <!-- Votos / Interacciones -->
        <div class="flex flex-col items-center justify-start gap-1 flex-shrink-0 pt-1">
          <button class="text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
          </button>
          <span class="font-bold text-sm">142</span>
          <button class="text-[var(--color-muted-foreground)] hover:text-[var(--color-primary)]">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
        </div>
        
        <!-- Contenido -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="font-bold text-[var(--color-foreground)] text-xs hover:underline cursor-pointer">c/Ideología</span>
            <span class="text-[var(--color-muted-foreground)] text-xs">• Publicado por <span class="hover:underline cursor-pointer font-medium">@crojas</span> hace 5 horas</span>
          </div>
          
          <h2 class="text-xl font-bold text-[var(--color-foreground)] mb-2 leading-snug cursor-pointer">Reevaluando el concepto de "Estado de Bienestar" en el contexto latinoamericano</h2>
          
          <div class="flex items-center gap-4 mt-3">
            <button class="flex items-center gap-1.5 text-xs font-bold text-[var(--color-muted-foreground)] hover:bg-[var(--color-secondary)] px-2 py-1 rounded-[var(--radius-sm)] transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              48 Comentarios
            </button>
            <button class="flex items-center gap-1.5 text-xs font-bold text-[var(--color-muted-foreground)] hover:bg-[var(--color-secondary)] px-2 py-1 rounded-[var(--radius-sm)] transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
              Compartir
            </button>
          </div>
        </div>
      </article>

      <!-- Hilo Anclado -->
      <article class="bg-[#FFFDF5] border border-[#E5E0C5] rounded-[var(--radius-sm)] p-4 flex gap-4 hover:border-[var(--color-foreground)] transition-colors">
        <!-- Votos / Interacciones -->
        <div class="flex flex-col items-center justify-start gap-1 flex-shrink-0 pt-1">
          <svg class="w-6 h-6 text-[#C8102E]" fill="currentColor" viewBox="0 0 24 24"><path d="M5 15l7-7 7 7"></path></svg>
          <span class="font-bold text-sm text-[#C8102E]">956</span>
        </div>
        
        <!-- Contenido -->
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 mb-1">
            <span class="bg-[#C8102E] text-white text-[9px] px-1.5 py-0.5 uppercase font-bold tracking-widest rounded-sm">Anclado</span>
            <span class="font-bold text-[var(--color-foreground)] text-xs hover:underline cursor-pointer">c/Anuncios</span>
            <span class="text-[var(--color-muted-foreground)] text-xs">• Publicado por <span class="hover:underline cursor-pointer font-bold text-[var(--color-foreground)]">Directiva Nacional</span></span>
          </div>
          
          <h2 class="text-xl font-bold text-[var(--color-foreground)] mb-2 leading-snug cursor-pointer">Reglamento interno de uso de Foros y Normas de Convivencia Digital</h2>
          
          <div class="flex items-center gap-4 mt-3">
            <button class="flex items-center gap-1.5 text-xs font-bold text-[var(--color-muted-foreground)] hover:bg-[#F0EDD5] px-2 py-1 rounded-[var(--radius-sm)] transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
              Cerrado a comentarios
            </button>
          </div>
        </div>
      </article>

    </div>
  </div>
</AppLayout>
