---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { forumCategoryTable, forumTopicTable } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const urlParams = new URL(Astro.request.url).searchParams;
const categoryId = urlParams.get('categoria');

if (!categoryId) return Astro.redirect('/foros');

const [category] = await db.select().from(forumCategoryTable).where(eq(forumCategoryTable.id, categoryId));
if (!category) return Astro.redirect('/foros');

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const title = formData.get('title')?.toString();
    const content = formData.get('content')?.toString();

    if (!title || !content) {
      errorMessage = 'El título y el mensaje son obligatorios.';
    } else {
      const topicId = crypto.randomUUID();
      await db.insert(forumTopicTable).values({
        id: topicId,
        title,
        content,
        categoryId: category.id,
        authorId: user.id
      });
      return Astro.redirect(`/foros/tema/${topicId}`);
    }
  } catch (e) {
    console.error(e);
    errorMessage = 'Error al crear el tema.';
  }
}
---

<AppLayout title="Crear Nuevo Tema">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8 border-b-4 border-[var(--color-foreground)] pb-4">
      <a href={`/foros/${category.id}`} class="text-xs font-bold text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] uppercase tracking-widest flex items-center gap-2 mb-4">
        ← Volver a {category.name}
      </a>
      <h1 class="text-4xl font-black uppercase tracking-tighter">Crear Nuevo Tema</h1>
      <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-1">Categoría: {category.name}</p>
    </div>

    {errorMessage && (
      <div class="bg-red-100 border-l-4 border-red-500 p-4 mb-8 text-red-700 font-bold uppercase tracking-widest text-sm">
        {errorMessage}
      </div>
    )}

    <form method="POST" class="space-y-8">
      <div class="space-y-2">
        <label for="title" class="block text-sm font-black uppercase tracking-widest text-[var(--color-foreground)]">Título del Debate *</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          required 
          class="w-full bg-[var(--color-background)] border-4 border-[var(--color-foreground)] p-4 text-xl font-bold focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] transition-colors shadow-[4px_4px_0px_0px_var(--color-foreground)]"
          placeholder="Ej: Reflexiones sobre el texto de la semana"
        />
      </div>

      <div class="space-y-2">
        <label for="content" class="block text-sm font-black uppercase tracking-widest text-[var(--color-foreground)]">Mensaje Inicial *</label>
        <div class="border-4 border-[var(--color-foreground)] bg-[var(--color-background)] focus-within:bg-white transition-colors shadow-[4px_4px_0px_0px_var(--color-foreground)] flex flex-col">
          <!-- Toolbar -->
          <div class="flex items-center gap-1 border-b-2 border-[var(--color-foreground)] p-2 bg-[var(--color-secondary)]">
            <button type="button" class="toolbar-btn px-3 py-1 hover:bg-white font-bold text-xs" data-tag="**">N</button>
            <button type="button" class="toolbar-btn px-3 py-1 hover:bg-white italic text-xs" data-tag="*">K</button>
            <button type="button" class="toolbar-btn px-3 py-1 hover:bg-white font-bold text-xs" data-tag="[Texto](url)">Link</button>
            <div class="w-px h-5 bg-[var(--color-foreground)] mx-2"></div>
            <!-- Adjuntar Archivo -->
            <label class="px-3 py-1 hover:bg-white font-bold text-xs cursor-pointer flex items-center gap-1">
              📎 Adjuntar
              <input type="file" id="attach-file" class="hidden" accept="image/*,.pdf" />
            </label>
            <!-- Citar Documento -->
            <button type="button" id="cite-doc-btn" class="px-3 py-1 hover:bg-white font-bold text-xs flex items-center gap-1">
              📄 Citar Doc
            </button>
          </div>
          <textarea 
            id="content" 
            name="content" 
            required
            rows="10" 
            class="w-full bg-transparent p-4 font-medium focus:outline-none resize-y"
            placeholder="Desarrolla tus ideas aquí... Puedes usar formato Markdown y pegar links de YouTube."
          ></textarea>
        </div>
        <p class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-2">Mantén el respeto y la camaradería durante todo el debate.</p>
      </div>

      <div class="pt-6 border-t-4 border-[var(--color-foreground)] flex justify-end gap-4">
        <a href={`/foros/${category.id}`} class="px-6 py-4 font-black uppercase tracking-widest border-2 border-[var(--color-foreground)] hover:bg-[var(--color-secondary)] transition-colors">
          Cancelar
        </a>
        <button type="submit" class="bg-[var(--color-primary)] text-white px-8 py-4 font-black uppercase tracking-widest border-2 border-[var(--color-primary)] shadow-[6px_6px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[2px_2px_0px_0px_var(--color-foreground)] transition-all">
          Publicar Tema
        </button>
      </div>
    </form>
  </div>
</AppLayout>

<script>
  // Simple toolbar logic
  const textarea = document.getElementById('content') as HTMLTextAreaElement;
  const toolbarBtns = document.querySelectorAll('.toolbar-btn');

  toolbarBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = (btn as HTMLElement).dataset.tag;
      if (!tag || !textarea) return;
      
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const text = textarea.value;
      
      if (tag === '[Texto](url)') {
        textarea.value = text.substring(0, start) + '[Enlace](https://...)' + text.substring(end);
      } else {
        textarea.value = text.substring(0, start) + tag + text.substring(start, end) + tag + text.substring(end);
      }
      textarea.focus();
    });
  });

  // Attach logic
  const attachInput = document.getElementById('attach-file') as HTMLInputElement;
  if (attachInput) {
    attachInput.addEventListener('change', async (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;

      const originalPlaceholder = textarea.placeholder;
      textarea.placeholder = 'Subiendo archivo...';
      textarea.disabled = true;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const res = await fetch('/api/upload-attachment', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        
        if (res.ok && data.url) {
          const isImage = file.type.startsWith('image/');
          const mdCode = isImage ? `![${file.name}](${data.url})` : `[📎 Adjunto: ${file.name}](${data.url})`;
          textarea.value += `\n${mdCode}\n`;
        } else {
          alert(data.error || 'Error al subir archivo');
        }
      } catch (err) {
        alert('Error de conexión');
      } finally {
        textarea.placeholder = originalPlaceholder;
        textarea.disabled = false;
        textarea.focus();
      }
    });
  }

  // Cite Doc logic
  const citeBtn = document.getElementById('cite-doc-btn');
  if (citeBtn) {
    citeBtn.addEventListener('click', () => {
      const docId = prompt('Ingresa la URL o ID del documento de la biblioteca:');
      if (docId) {
        textarea.value += `\n[📄 Documento Citado](/biblioteca/${docId.replace('/biblioteca/', '')})\n`;
      }
    });
  }
</script>
