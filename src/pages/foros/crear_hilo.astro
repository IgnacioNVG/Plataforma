---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { forumCategoryTable, forumTopicTable } from '../../db/schema';
import { eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const urlParams = new URL(Astro.request.url).searchParams;
const categoryId = urlParams.get('categoria');

if (!categoryId) return Astro.redirect('/foros');

const [category] = await db.select().from(forumCategoryTable).where(eq(forumCategoryTable.id, categoryId));
if (!category) return Astro.redirect('/foros');

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const title = formData.get('title')?.toString();
    const content = formData.get('content')?.toString();

    if (!title || !content) {
      errorMessage = 'El título y el mensaje son obligatorios.';
    } else {
      const topicId = crypto.randomUUID();
      await db.insert(forumTopicTable).values({
        id: topicId,
        title,
        content,
        categoryId: category.id,
        authorId: user.id
      });
      return Astro.redirect(`/foros/tema/${topicId}`);
    }
  } catch (e) {
    console.error(e);
    errorMessage = 'Error al crear el tema.';
  }
}
---

<AppLayout title="Crear Nuevo Tema">
  <div class="max-w-4xl mx-auto">
    <div class="mb-8 border-b-4 border-[var(--color-foreground)] pb-4">
      <a href={`/foros/${category.id}`} class="text-xs font-bold text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] uppercase tracking-widest flex items-center gap-2 mb-4">
        ← Volver a {category.name}
      </a>
      <h1 class="text-4xl font-black uppercase tracking-tighter">Crear Nuevo Tema</h1>
      <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-1">Categoría: {category.name}</p>
    </div>

    {errorMessage && (
      <div class="bg-red-100 border-l-4 border-red-500 p-4 mb-8 text-red-700 font-bold uppercase tracking-widest text-sm">
        {errorMessage}
      </div>
    )}

    <form method="POST" class="space-y-8">
      <div class="space-y-2">
        <label for="title" class="block text-sm font-black uppercase tracking-widest text-[var(--color-foreground)]">Título del Debate *</label>
        <input 
          type="text" 
          id="title" 
          name="title" 
          required 
          class="w-full bg-[var(--color-background)] border-4 border-[var(--color-foreground)] p-4 text-xl font-bold focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] transition-colors shadow-[4px_4px_0px_0px_var(--color-foreground)]"
          placeholder="Ej: Reflexiones sobre el texto de la semana"
        />
      </div>

      <div class="space-y-2">
        <label for="content" class="block text-sm font-black uppercase tracking-widest text-[var(--color-foreground)]">Mensaje Inicial *</label>
        <textarea 
          id="content" 
          name="content" 
          required
          rows="10" 
          class="w-full bg-[var(--color-background)] border-4 border-[var(--color-foreground)] p-4 font-medium focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] transition-colors shadow-[4px_4px_0px_0px_var(--color-foreground)]"
          placeholder="Desarrolla tus ideas aquí..."
        ></textarea>
        <p class="text-xs font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-2">Mantén el respeto y la camaradería durante todo el debate.</p>
      </div>

      <div class="pt-6 border-t-4 border-[var(--color-foreground)] flex justify-end gap-4">
        <a href={`/foros/${category.id}`} class="px-6 py-4 font-black uppercase tracking-widest border-2 border-[var(--color-foreground)] hover:bg-[var(--color-secondary)] transition-colors">
          Cancelar
        </a>
        <button type="submit" class="bg-[var(--color-primary)] text-white px-8 py-4 font-black uppercase tracking-widest border-2 border-[var(--color-primary)] shadow-[6px_6px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[2px_2px_0px_0px_var(--color-foreground)] transition-all">
          Publicar Tema
        </button>
      </div>
    </form>
  </div>
</AppLayout>
