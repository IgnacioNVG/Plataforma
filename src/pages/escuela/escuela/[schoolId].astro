---
import AppLayout from '../../../layouts/AppLayout.astro';
import { db } from '../../../db';
import { schoolTable, courseTable, enrollmentTable, moduleTable } from '../../../db/schema';
import { eq, and } from 'drizzle-orm';
// Removed crypto import to use global crypto

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/validacion');
}

const schoolId = Astro.params.schoolId;
if (!schoolId) return Astro.redirect('/escuela/catalogo');

const [school] = await db.select().from(schoolTable).where(eq(schoolTable.id, schoolId));
if (!school) return Astro.redirect('/escuela/catalogo');

// Manejar inscripción a cursos
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const action = data.get('action') as string;
    
    if (action === 'enroll') {
      const courseId = data.get('courseId') as string;
      if (courseId) {
        const existing = await db.select().from(enrollmentTable).where(
          and(eq(enrollmentTable.userId, user.id), eq(enrollmentTable.courseId, courseId))
        );
        
        if (existing.length === 0) {
          await db.insert(enrollmentTable).values({
            id: crypto.randomUUID(),
            userId: user.id,
            courseId: courseId,
            status: 'en_progreso',
            progressPercentage: 0
          });
          
          return Astro.redirect(`/escuela/curso/${courseId}`);
        } else {
          return Astro.redirect(`/escuela/curso/${courseId}`);
        }
      }
    }
  } catch(e: any) {
    error = 'Error al inscribirse en el curso.';
  }
}

// Cursos de esta escuela
const courses = await db.select().from(courseTable).where(
  and(eq(courseTable.schoolId, school.id), eq(courseTable.status, 'publicado'))
);

// Conteo de módulos
const allModules = await db.select({ courseId: moduleTable.courseId }).from(moduleTable);
const modulesCount = allModules.reduce((acc, mod) => {
  acc[mod.courseId] = (acc[mod.courseId] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

// Inscripciones del usuario
const myEnrollments = await db.select().from(enrollmentTable).where(eq(enrollmentTable.userId, user.id));
const enrolledCourseIds = new Set(myEnrollments.map(e => e.courseId));

---

<AppLayout title={school.name}>
  <div class="mb-8 border-b-4 border-[var(--color-foreground)] pb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
    <div>
      <a href="/escuela/catalogo" class="text-[10px] font-black uppercase tracking-widest hover:text-[var(--color-primary)] transition-colors mb-4 block">&larr; Volver al Catálogo</a>
      <span class="text-[var(--color-primary)] font-black text-xs uppercase tracking-widest mb-2 block">Escuela de Formación</span>
      <h1 class="text-4xl font-black text-[var(--color-foreground)] uppercase tracking-tighter leading-none">{school.name}</h1>
      <p class="text-sm font-bold text-[var(--color-muted-foreground)] uppercase tracking-widest mt-4 max-w-2xl">{school.description}</p>
      {school.targetAudience && (
        <span class="inline-block mt-4 bg-[var(--color-secondary)] text-[var(--color-foreground)] text-[10px] font-black uppercase tracking-widest px-2 py-1 border-2 border-[var(--color-foreground)] shadow-[2px_2px_0px_0px_var(--color-foreground)]">
          Público Objetivo: {school.targetAudience}
        </span>
      )}
    </div>
  </div>

  {error && (
    <div class="bg-red-50 border-2 border-red-600 text-red-700 p-4 mb-8 font-bold text-sm uppercase tracking-widest shadow-[4px_4px_0px_0px_#dc2626]">
      {error}
    </div>
  )}

  <h2 class="text-2xl font-black uppercase tracking-tighter mb-6">Cursos Disponibles</h2>

  {courses.length === 0 ? (
    <div class="bg-[var(--color-secondary)] border-2 border-[var(--color-border)] p-12 text-center">
      <p class="text-sm font-bold text-[var(--color-muted-foreground)]">Esta escuela aún no tiene cursos publicados.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {courses.map(course => {
        const isEnrolled = enrolledCourseIds.has(course.id);
        const count = modulesCount[course.id] || 0;

        return (
          <div class="bg-[var(--color-background)] border-4 border-[var(--color-foreground)] shadow-[8px_8px_0px_0px_var(--color-foreground)] flex flex-col group hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[12px_12px_0px_0px_var(--color-foreground)] transition-all">
            
            <div class="h-32 bg-[var(--color-secondary)] border-b-4 border-[var(--color-foreground)] relative overflow-hidden flex-shrink-0">
              <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, black 1px, transparent 0); background-size: 16px 16px;"></div>
              
              <div class="absolute top-2 left-2 flex gap-2">
                {course.isMandatory && (
                  <span class="bg-[var(--color-primary)] text-white text-[10px] uppercase font-black tracking-widest px-2 py-1 shadow-[2px_2px_0px_0px_var(--color-foreground)] border border-[var(--color-foreground)]">
                    Obligatorio
                  </span>
                )}
                <span class="bg-white text-[var(--color-foreground)] text-[10px] uppercase font-black tracking-widest px-2 py-1 shadow-[2px_2px_0px_0px_var(--color-foreground)] border border-[var(--color-foreground)]">
                  {count} Módulos
                </span>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-black uppercase leading-tight mb-2 group-hover:text-[var(--color-primary)] transition-colors">{course.title}</h3>
              <p class="text-sm font-medium text-[var(--color-muted-foreground)] line-clamp-3 mb-6 flex-grow">{course.description}</p>
              
              {isEnrolled ? (
                <a href={`/escuela/curso/${course.id}`} class="w-full block text-center bg-[var(--color-secondary)] text-[var(--color-foreground)] px-6 py-3 font-black text-xs uppercase tracking-widest border-2 border-[var(--color-foreground)] shadow-[4px_4px_0px_0px_var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-foreground)] transition-all mt-auto">
                  Continuar Curso
                </a>
              ) : (
                <form method="POST" class="mt-auto">
                  <input type="hidden" name="action" value="enroll" />
                  <input type="hidden" name="courseId" value={course.id} />
                  <button type="submit" class="w-full bg-[var(--color-foreground)] text-white px-6 py-3 font-black text-xs uppercase tracking-widest border-2 border-transparent shadow-[4px_4px_0px_0px_var(--color-primary)] hover:border-[var(--color-foreground)] hover:translate-y-1 hover:translate-x-1 hover:shadow-[0px_0px_0px_0px_var(--color-primary)] transition-all">
                    Inscribirse
                  </button>
                </form>
              )}
            </div>
          </div>
        );
      })}
    </div>
  )}
</AppLayout>
