---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Escuela de Formación">
  <!-- Header de Sección -->
  <div class="mb-8 border-b border-[var(--color-foreground)] pb-6 flex justify-between items-end">
    <div>
      <span class="text-[var(--color-primary)] font-bold text-xs uppercase tracking-widest mb-2 block">Instituto Igualdad</span>
      <h1 class="text-4xl font-bold text-[var(--color-foreground)]">Escuela de Formación</h1>
      <p class="text-[var(--color-muted-foreground)] mt-2 max-w-2xl">Módulos obligatorios y optativos para el desarrollo político y programático de la militancia.</p>
    </div>
    
    <!-- Tabs Navigation -->
    <div class="flex gap-4">
      <button class="text-sm font-bold border-b-2 border-[var(--color-foreground)] pb-1">En Progreso (2)</button>
      <button class="text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] pb-1">Completados (5)</button>
      <button class="text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] pb-1">Catálogo</button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Columna Izquierda: Cursos Activos (2/3) -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Card de Curso en Progreso -->
      <article class="flex flex-col md:flex-row gap-6 border border-[var(--color-border)] bg-[var(--color-background)] p-6 rounded-[var(--radius-sm)] group hover:border-[var(--color-foreground)] transition-colors">
        <div class="w-full md:w-48 h-32 bg-[var(--color-secondary)] rounded-[var(--radius-sm)] flex-shrink-0 border border-[var(--color-border)] relative overflow-hidden">
          <div class="w-full h-full bg-gray-300"></div>
          <div class="absolute top-2 left-2 bg-[var(--color-foreground)] text-white text-[10px] uppercase font-bold px-2 py-0.5 rounded-[var(--radius-sm)]">
            Obligatorio
          </div>
        </div>
        
        <div class="flex-1 flex flex-col">
          <h2 class="text-xl font-bold text-[var(--color-foreground)] mb-1">Historia del Movimiento Obrero Chileno</h2>
          <p class="text-sm text-[var(--color-muted-foreground)] line-clamp-2 mb-4">Análisis histórico desde las primeras mancomunales hasta la formación de las centrales sindicales modernas.</p>
          
          <div class="mt-auto">
            <div class="flex justify-between text-xs text-[var(--color-muted-foreground)] mb-1 font-medium">
              <span>Módulo 3: La Cuestión Social</span>
              <span>60% Completado</span>
            </div>
            <!-- Barra de Progreso Brutalista -->
            <div class="w-full h-2 bg-[var(--color-border)] rounded-[var(--radius-sm)] overflow-hidden mb-4">
              <div class="h-full bg-[var(--color-primary)] w-[60%]"></div>
            </div>
            
            <div class="flex gap-3">
              <button class="bg-[var(--color-foreground)] text-white px-4 py-1.5 text-sm font-medium rounded-[var(--radius-sm)] hover:bg-gray-800 transition-colors">
                Retomar Módulo
              </button>
              <button class="border border-[var(--color-border)] px-4 py-1.5 text-sm font-medium rounded-[var(--radius-sm)] hover:bg-[var(--color-secondary)] transition-colors">
                Ver Sílabo
              </button>
            </div>
          </div>
        </div>
      </article>
      
    </div>

    <!-- Columna Derecha: Próximas Evaluaciones y Materiales -->
    <div class="space-y-8">
      
      <section class="border border-[var(--color-foreground)] bg-[var(--color-background)] p-6 rounded-[var(--radius-sm)]">
        <h3 class="text-lg font-bold border-b border-[var(--color-foreground)] pb-2 mb-4">Próximas Evaluaciones</h3>
        
        <ul class="space-y-4">
          <!-- Tarea -->
          <li class="group">
            <div class="flex justify-between items-start mb-1">
              <span class="text-xs font-bold text-[var(--color-primary)] uppercase">Para el Viernes, 23:59</span>
              <span class="bg-[var(--color-secondary)] text-[var(--color-foreground)] text-[10px] font-bold px-2 py-0.5 rounded-[var(--radius-sm)] border border-[var(--color-border)]">Ensayo</span>
            </div>
            <h4 class="font-medium text-sm group-hover:underline cursor-pointer">Impacto de la Constitución del 25</h4>
            <p class="text-xs text-[var(--color-muted-foreground)]">Curso: Formación Constitucional</p>
          </li>
        </ul>
      </section>

      <section class="border border-[var(--color-border)] bg-[var(--color-secondary)] p-6 rounded-[var(--radius-sm)]">
        <h3 class="text-sm font-bold text-[var(--color-foreground)] uppercase tracking-widest mb-4">Materiales Sugeridos</h3>
        <ul class="space-y-3">
          <li>
            <a href="#" class="flex items-center gap-3 text-sm hover:text-[var(--color-primary)] transition-colors group">
              <svg class="w-4 h-4 text-[var(--color-muted-foreground)] group-hover:text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
              Lectura: "El Socialismo Chileno" (PDF)
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</AppLayout>
