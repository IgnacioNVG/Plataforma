---
import AppLayout from '../../layouts/AppLayout.astro';
import { db } from '../../db';
import { schoolTable, courseTable, enrollmentTable, moduleTable, moduleProgressTable } from '../../db/schema';
import { eq, and } from 'drizzle-orm';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/validacion');
}

// Fetch user's enrollments with course and school data
const myEnrollments = await db.select({
  enrollment: enrollmentTable,
  course: courseTable,
  school: schoolTable
}).from(enrollmentTable)
  .innerJoin(courseTable, eq(enrollmentTable.courseId, courseTable.id))
  .innerJoin(schoolTable, eq(courseTable.schoolId, schoolTable.id))
  .where(eq(enrollmentTable.userId, user.id));

// For each enrolled course, get its modules and progress
const schoolsMap = new Map();

for (const entry of myEnrollments) {
  const { enrollment, course, school } = entry;
  
  const modules = await db.select().from(moduleTable).where(eq(moduleTable.courseId, course.id)).orderBy(moduleTable.order);
  const completed = await db.select().from(moduleProgressTable).where(eq(moduleProgressTable.enrollmentId, enrollment.id));
  
  const total = modules.length;
  const done = completed.length;
  const percentage = total === 0 ? 0 : Math.round((done / total) * 100);
  
  if (percentage !== enrollment.progressPercentage || (percentage === 100 && enrollment.status !== 'completado')) {
    await db.update(enrollmentTable).set({
      progressPercentage: percentage,
      status: percentage === 100 ? 'completado' : 'en_progreso'
    }).where(eq(enrollmentTable.id, enrollment.id));
    enrollment.progressPercentage = percentage;
    enrollment.status = percentage === 100 ? 'completado' : 'en_progreso';
  }
  
  const courseData = { ...course, enrollment, totalModules: total, completedModules: done, nextModule: null };
  
  if (percentage < 100 && total > 0) {
    const completedIds = new Set(completed.map(c => c.moduleId));
    courseData.nextModule = modules.find(m => !completedIds.has(m.id));
  }
  
  if (!schoolsMap.has(school.id)) {
    schoolsMap.set(school.id, {
      school,
      activeCourses: [],
      completedCourses: []
    });
  }
  
  if (enrollment.status === 'completado') {
    schoolsMap.get(school.id).completedCourses.push(courseData);
  } else {
    schoolsMap.get(school.id).activeCourses.push(courseData);
  }
}

const enrolledSchools = Array.from(schoolsMap.values());
---

<AppLayout title="Escuela de Formación">
  <!-- Header de Sección -->
  <div class="mb-8 border-b border-[var(--color-foreground)] pb-6 flex justify-between items-end">
    <div>
      <span class="text-[var(--color-primary)] font-bold text-xs uppercase tracking-widest mb-2 block">Instituto Igualdad</span>
      <h1 class="text-4xl font-bold text-[var(--color-foreground)]">Escuela de Formación</h1>
      <p class="text-[var(--color-muted-foreground)] mt-2 max-w-2xl">Módulos obligatorios y optativos para el desarrollo político y programático de la militancia.</p>
    </div>
    
    <!-- Tabs Navigation -->
    <div class="flex gap-4">
      <span class="text-sm font-black uppercase tracking-widest border-b-4 border-[var(--color-foreground)] pb-1">En Curso / Completados</span>
      <a href="/escuela/catalogo" class="text-sm font-black uppercase tracking-widest text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors pb-1">Catálogo</a>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Columna Izquierda: Escuelas y Cursos (2/3) -->
    <div class="lg:col-span-2 space-y-12">
      
      {enrolledSchools.length === 0 ? (
        <div class="bg-[var(--color-secondary)] border-2 border-[var(--color-border)] p-8 text-center">
          <p class="text-xs font-bold uppercase tracking-widest text-[var(--color-muted-foreground)]">No tienes cursos en progreso.</p>
          <a href="/escuela/catalogo" class="inline-block mt-4 bg-[var(--color-foreground)] text-white px-4 py-2 font-black text-xs uppercase tracking-widest hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--color-primary)] transition-all">Ver Catálogo de Escuelas</a>
        </div>
      ) : (
        enrolledSchools.map(({ school, activeCourses, completedCourses }) => (
          <div class="border-4 border-[var(--color-foreground)] bg-white p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--color-foreground)]">
            <div class="border-b-4 border-dashed border-[var(--color-border)] pb-4 mb-6">
              <span class="text-[10px] font-black uppercase tracking-widest text-[var(--color-primary)] bg-[var(--color-secondary)] px-2 py-1 mb-2 inline-block">Escuela</span>
              <h2 class="text-3xl font-black uppercase tracking-tighter leading-none"><a href={`/escuela/escuela/${school.id}`} class="hover:text-[var(--color-primary)]">{school.name}</a></h2>
            </div>
            
            {activeCourses.length > 0 && (
              <div class="space-y-6">
                <h3 class="text-sm font-black uppercase tracking-widest text-[var(--color-muted-foreground)]">Cursos en Progreso</h3>
                {activeCourses.map(c => (
                  <article class="flex flex-col md:flex-row gap-0 border-2 border-[var(--color-foreground)] bg-[var(--color-background)] group hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[8px_8px_0px_0px_var(--color-foreground)] transition-all">
                    <div class="w-full md:w-32 h-32 bg-[var(--color-secondary)] border-b-2 md:border-b-0 md:border-r-2 border-[var(--color-foreground)] relative flex-shrink-0">
                      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, black 1px, transparent 0); background-size: 16px 16px;"></div>
                      {c.isMandatory && (
                        <div class="absolute top-2 left-2 bg-[var(--color-primary)] text-white text-[8px] uppercase font-black tracking-widest px-1.5 py-0.5 shadow-[2px_2px_0px_0px_var(--color-foreground)] border border-[var(--color-foreground)]">
                          Obligatorio
                        </div>
                      )}
                    </div>
                    
                    <div class="flex-1 flex flex-col p-4">
                      <h4 class="text-lg font-black uppercase leading-tight mb-1"><a href={`/escuela/curso/${c.id}`} class="hover:text-[var(--color-primary)]">{c.title}</a></h4>
                      
                      <div class="mt-auto">
                        <div class="flex justify-between text-[9px] font-black uppercase tracking-widest text-[var(--color-foreground)] mb-2">
                          <span>{c.nextModule ? `Sig: Módulo ${c.nextModule.order}` : 'Progreso'}</span>
                          <span>{c.enrollment.progressPercentage}%</span>
                        </div>
                        <div class="w-full h-2 border-2 border-[var(--color-foreground)] bg-[var(--color-secondary)] mb-4">
                          <div class="h-full bg-[var(--color-primary)] border-r-2 border-[var(--color-foreground)]" style={`width: ${c.enrollment.progressPercentage}%`}></div>
                        </div>
                        
                        <div class="flex gap-2">
                          {c.nextModule ? (
                            <a href={`/escuela/curso/${c.id}/modulo/${c.nextModule.id}`} class="flex-1 text-center bg-[var(--color-foreground)] text-white px-3 py-1.5 text-[9px] font-black uppercase tracking-widest border-2 border-transparent shadow-[2px_2px_0px_0px_var(--color-primary)] hover:translate-y-px hover:translate-x-px hover:shadow-[0px_0px_0px_0px_var(--color-primary)] transition-all">
                              Retomar
                            </a>
                          ) : (
                            <a href={`/escuela/curso/${c.id}`} class="flex-1 text-center bg-[var(--color-foreground)] text-white px-3 py-1.5 text-[9px] font-black uppercase tracking-widest border-2 border-transparent shadow-[2px_2px_0px_0px_var(--color-primary)] hover:translate-y-px hover:translate-x-px hover:shadow-[0px_0px_0px_0px_var(--color-primary)] transition-all">
                              Ver Curso
                            </a>
                          )}
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            )}
            
            {completedCourses.length > 0 && (
              <div class="mt-8">
                <h3 class="text-sm font-black uppercase tracking-widest text-[var(--color-muted-foreground)] mb-4">Cursos Completados</h3>
                <div class="grid grid-cols-1 gap-2">
                  {completedCourses.map(c => (
                    <a href={`/escuela/curso/${c.id}`} class="border-2 border-[var(--color-foreground)] bg-[var(--color-secondary)] p-3 flex items-center justify-between group hover:bg-[var(--color-background)] transition-colors">
                      <span class="font-bold text-xs uppercase group-hover:text-[var(--color-primary)] truncate pr-4">{c.title}</span>
                      <span class="bg-[#16a34a] text-white font-black text-[9px] uppercase tracking-widest px-2 py-0.5 border border-[#14532d] flex-shrink-0">✓ Completado</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
            
          </div>
        ))
      )}
      
    </div>

    <!-- Columna Derecha: Próximas Evaluaciones y Materiales -->
    <div class="space-y-8">
      
      <section class="border border-[var(--color-foreground)] bg-[var(--color-background)] p-6 rounded-[var(--radius-sm)]">
        <h3 class="text-lg font-bold border-b border-[var(--color-foreground)] pb-2 mb-4">Próximas Evaluaciones</h3>
        
        <ul class="space-y-4">
          <!-- Tarea -->
          <li class="group">
            <div class="flex justify-between items-start mb-1">
              <span class="text-xs font-bold text-[var(--color-primary)] uppercase">Para el Viernes, 23:59</span>
              <span class="bg-[var(--color-secondary)] text-[var(--color-foreground)] text-[10px] font-bold px-2 py-0.5 rounded-[var(--radius-sm)] border border-[var(--color-border)]">Ensayo</span>
            </div>
            <h4 class="font-medium text-sm group-hover:underline cursor-pointer">Impacto de la Constitución del 25</h4>
            <p class="text-xs text-[var(--color-muted-foreground)]">Curso: Formación Constitucional</p>
          </li>
        </ul>
      </section>

      <section class="border border-[var(--color-border)] bg-[var(--color-secondary)] p-6 rounded-[var(--radius-sm)]">
        <h3 class="text-sm font-bold text-[var(--color-foreground)] uppercase tracking-widest mb-4">Materiales Sugeridos</h3>
        <ul class="space-y-3">
          <li>
            <a href="#" class="flex items-center gap-3 text-sm hover:text-[var(--color-primary)] transition-colors group">
              <svg class="w-4 h-4 text-[var(--color-muted-foreground)] group-hover:text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
              Lectura: "El Socialismo Chileno" (PDF)
            </a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</AppLayout>
