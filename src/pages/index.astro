---
import AppLayout from '../layouts/AppLayout.astro';
import { db } from '../db';
import { newsTable, eventTable } from '../db/schema';
import { desc, asc, gte } from 'drizzle-orm';

const latestNews = await db.select().from(newsTable).orderBy(desc(newsTable.publishedAt)).limit(3);

const today = new Date();
today.setHours(0,0,0,0);
const upcomingEvents = await db.select().from(eventTable)
  .where(gte(eventTable.startDate, today))
  .orderBy(asc(eventTable.startDate))
  .limit(4);

---

<AppLayout title="Inicio">
  <!-- Hero Documental (Aspecto Revista / Brutalista) -->
  <section class="relative h-96 w-full bg-[var(--color-foreground)] border border-[var(--color-foreground)] rounded-[var(--radius-sm)] overflow-hidden mb-8">
    <div class="absolute inset-0 bg-gray-800 opacity-60"></div>
    <div class="absolute inset-0 p-8 flex flex-col justify-end">
      <span class="bg-[var(--color-primary)] text-[var(--color-primary-foreground)] text-xs font-bold px-2 py-1 uppercase tracking-widest w-max mb-4">Comunicado Oficial</span>
      <h2 class="text-4xl md:text-5xl font-bold text-white max-w-3xl leading-tight mb-4">
        Resoluciones del Comité Central respecto a los nuevos desafíos formativos
      </h2>
      <div class="flex gap-4">
        <button class="bg-[var(--color-background)] text-[var(--color-foreground)] px-6 py-2 rounded-[var(--radius-sm)] font-medium hover:bg-white transition-colors">
          Leer Documento
        </button>
      </div>
    </div>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Columna Principal (2/3) -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Grid Accesos Rápidos (Brutalistas) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <!-- Card -->
        <a href="/biblioteca" class="block p-4 border border-[var(--color-border)] rounded-[var(--radius-sm)] bg-[var(--color-background)] hover:border-[var(--color-foreground)] hover:bg-[var(--color-secondary)] transition-colors group">
          <h3 class="font-bold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">Biblioteca</h3>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">142 Documentos</p>
        </a>
        <!-- Card -->
        <a href="/comisiones" class="block p-4 border border-[var(--color-border)] rounded-[var(--radius-sm)] bg-[var(--color-background)] hover:border-[var(--color-foreground)] hover:bg-[var(--color-secondary)] transition-colors group">
          <h3 class="font-bold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">Comisiones</h3>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Tus grupos activos</p>
        </a>
        <!-- Card -->
        <a href="/directorio" class="block p-4 border border-[var(--color-border)] rounded-[var(--radius-sm)] bg-[var(--color-background)] hover:border-[var(--color-foreground)] hover:bg-[var(--color-secondary)] transition-colors group">
          <h3 class="font-bold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">Directorio</h3>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Contactos clave</p>
        </a>
        <!-- Card -->
        <a href="/foros" class="block p-4 border border-[var(--color-border)] rounded-[var(--radius-sm)] bg-[var(--color-background)] hover:border-[var(--color-foreground)] hover:bg-[var(--color-secondary)] transition-colors group">
          <h3 class="font-bold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors">Foros</h3>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Debates internos</p>
        </a>
      </div>

      <!-- Sección de Noticias (Editorial) -->
      <section>
        <div class="flex justify-between items-end border-b border-[var(--color-foreground)] pb-2 mb-6">
          <h3 class="text-2xl font-bold">Últimas Noticias</h3>
          <a href="/noticias" class="text-sm font-medium text-[var(--color-primary)] hover:underline">Ver todas</a>
        </div>
        
        <div class="space-y-6">
          {latestNews.length === 0 ? (
            <p class="text-sm text-[var(--color-muted-foreground)] italic">No hay noticias publicadas.</p>
          ) : (
            latestNews.map(news => (
              <a href={`/noticias/${news.slug}`} class="flex gap-6 group cursor-pointer hover:bg-[var(--color-secondary)] p-2 -mx-2 rounded-[var(--radius-sm)] transition-colors">
                <div class="w-48 h-32 bg-[var(--color-secondary)] rounded-[var(--radius-sm)] overflow-hidden flex-shrink-0 border border-[var(--color-border)] relative">
                  {news.imageUrl ? (
                    <img src={news.imageUrl} alt={news.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="w-full h-full bg-gray-400 flex items-center justify-center">
                      <svg class="w-8 h-8 text-white opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H15"></path></svg>
                    </div>
                  )}
                </div>
                <div>
                  <div class="flex gap-2 mb-2">
                    <span class="text-xs font-bold text-[var(--color-primary)] uppercase">Boletín</span>
                    <span class="text-xs text-[var(--color-muted-foreground)]">
                      {new Date(news.publishedAt).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })}
                    </span>
                  </div>
                  <h4 class="text-xl font-bold mb-2 group-hover:underline decoration-2 text-[var(--color-foreground)]">{news.title}</h4>
                  <p class="text-sm text-[var(--color-muted-foreground)] line-clamp-2">
                    {news.content.replace(/<[^>]*>?/gm, '').substring(0, 150)}...
                  </p>
                </div>
              </a>
            ))
          )}
        </div>
      </section>

    </div>

    <!-- Columna Secundaria (1/3) -->
    <div class="space-y-8">
      


      <!-- Agenda -->
      <section class="border border-[var(--color-border)] bg-[var(--color-background)] p-6 rounded-[var(--radius-sm)]">
        <div class="flex justify-between items-end border-b border-[var(--color-border)] pb-2 mb-4">
          <h3 class="text-lg font-bold">Próximos Eventos</h3>
          <a href="/agenda" class="text-xs font-bold text-[var(--color-primary)] hover:underline uppercase tracking-widest">Ver Agenda</a>
        </div>
        
        <ul class="space-y-4">
          {upcomingEvents.length === 0 ? (
            <p class="text-xs text-[var(--color-muted-foreground)] italic">No hay eventos próximos agendados.</p>
          ) : (
            upcomingEvents.map(event => (
              <li class="flex gap-4">
                <div class="flex flex-col items-center justify-center w-12 h-12 bg-[var(--color-secondary)] border border-[var(--color-border)] rounded-[var(--radius-sm)] flex-shrink-0">
                  <span class="text-xs font-bold text-[var(--color-primary)] uppercase">
                    {new Date(event.startDate).toLocaleDateString('es-CL', { month: 'short' })}
                  </span>
                  <span class="text-lg font-bold leading-none">
                    {new Date(event.startDate).getDate()}
                  </span>
                </div>
                <div>
                  <h4 class="font-bold text-sm text-[var(--color-foreground)]">{event.title}</h4>
                  <p class="text-xs text-[var(--color-muted-foreground)]">
                    {new Date(event.startDate).toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' })} hrs 
                    {event.location ? `• ${event.location}` : ''}
                  </p>
                </div>
              </li>
            ))
          )}
        </ul>
      </section>

      <!-- Estado Escuela de Formación -->
      <section class="border border-[var(--color-foreground)] bg-[var(--color-foreground)] text-white p-6 rounded-[var(--radius-sm)]">
        <h3 class="text-lg font-bold mb-2 text-white">Tu Progreso Formativo</h3>
        <p class="text-sm text-gray-400 mb-4">Curso: Historia y Memoria: Datos Curiosos de la JS</p>
        
        <!-- Progress Bar (Brutalista) -->
        <div class="w-full h-3 bg-[#333333] rounded-[var(--radius-sm)] overflow-hidden mb-2">
          <div class="h-full bg-[var(--color-primary)] w-[0%]"></div>
        </div>
        <div class="flex justify-between text-xs text-gray-400">
          <span>0% Completado</span>
          <span>Módulo 1 de 5</span>
        </div>
        
        <a href="/escuela" class="w-full mt-6 bg-[var(--color-background)] text-[var(--color-foreground)] font-bold text-sm py-2 rounded-[var(--radius-sm)] hover:bg-gray-200 transition-colors inline-block text-center cursor-pointer">
          Comenzar Curso
        </a>
      </section>
    </div>
  </div>
</AppLayout>
