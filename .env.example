# ENTORNO DE DESARROLLO
NODE_ENV=development

# BASE DE DATOS (URL de conexión para Drizzle)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/js_platform

# CORREO ELECTRÓNICO (SMTP) - Opcional para desarrollo local (se usa Mailpit por defecto)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jschile.local

# SEGURIDAD Y SESIONES
# En producción, usar una cadena larga y segura
SESSION_SECRET=super-secret-development-key-change-in-production
